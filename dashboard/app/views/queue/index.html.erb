<div class="max-w-6xl mx-auto p-6 space-y-8" data-controller="auto-refresh" data-auto-refresh-interval-value="15000">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Scheduling Queue</h1>
      <p class="text-slate-500 text-sm mt-1">Antrean eksekusi check mendatang yang dijadwalkan oleh Nagios Core Engine</p>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
          <th class="py-3.5 px-6">Waktu Check Mendatang</th>
          <th class="py-3.5 px-6">Host</th>
          <th class="py-3.5 px-6">Service</th>
          <th class="py-3.5 px-6">Status Terakhir</th>
          <th class="py-3.5 px-6 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @queue.empty? %>
          <tr>
            <td colspan="5" class="py-12 px-6 text-center text-slate-400">
              Tidak ada antrean check terdaftar.
            </td>
          </tr>
        <% else %>
          <% @queue.each do |item| %>
            <tr class="hover:bg-slate-50 transition">
              <td class="py-4 px-6 text-sm font-mono text-indigo-600 font-bold">
                <%= item[:next_check].strftime("%H:%M:%S (%d %b)") %>
              </td>
              <td class="py-4 px-6 text-sm font-semibold text-slate-800">
                <%= item[:host_name] %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-700">
                <%= item[:description] %>
              </td>
              <td class="py-4 px-6 text-sm">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold <%= item[:status] == 'OK' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                  ● <%= item[:status] %>
                </span>
              </td>
              <td class="py-4 px-6 text-right">
                <%= button_to recheck_service_host_path(item[:host_name], service_desc: item[:description]),
                              method: :post,
                              class: "text-xs px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-md transition cursor-pointer" do %>
                  Force Check Now
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
