<!-- Quick Search Command Palette Modal Dialog -->
<div data-quick-search-target="modal" data-action="click->quick-search#closeOnBackdrop" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs flex items-start justify-center pt-20 p-4 hidden">
  <div class="w-full max-w-xl bg-white dark:bg-slate-900 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden transform transition-all">
    <!-- Input Header -->
    <div class="p-3 border-b border-slate-200 dark:border-slate-800 flex items-center gap-3">
      <svg class="w-5 h-5 text-indigo-500 shrink-0 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      <input type="text"
             data-quick-search-target="input"
             data-action="input->quick-search#filter"
             placeholder="Search hosts, services, hostgroups, or navigation pages..."
             class="w-full bg-transparent text-slate-800 dark:text-slate-100 placeholder-slate-400 text-sm focus:outline-none" />
      <button type="button" data-action="click->quick-search#close" class="text-xs px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 font-mono">ESC</button>
    </div>

    <!-- Search Results -->
    <div data-quick-search-target="resultsContainer" class="max-h-80 overflow-y-auto p-2 space-y-1">
      <!-- Dynamic Results Injected by Stimulus -->
    </div>

    <!-- Empty State -->
    <div data-quick-search-target="emptyState" class="p-8 text-center text-slate-400 dark:text-slate-500 text-xs hidden">
      Tidak ada hasil yang cocok dengan pencarian Anda.
    </div>

    <!-- Keyboard Navigation Help Footer -->
    <div class="px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400 dark:text-slate-500">
      <div class="flex items-center gap-3">
        <span><kbd class="px-1 py-0.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded font-mono">↑</kbd> <kbd class="px-1 py-0.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded font-mono">↓</kbd> Navigasi</span>
        <span><kbd class="px-1 py-0.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded font-mono">↵</kbd> Buka</span>
      </div>
      <span><kbd class="px-1 py-0.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded font-mono">ESC</kbd> Tutup</span>
    </div>
  </div>
</div>
