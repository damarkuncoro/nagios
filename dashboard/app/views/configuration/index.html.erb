<div class="max-w-6xl mx-auto p-6 space-y-8">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Objects Configuration Viewer</h1>
      <p class="text-slate-500 text-sm mt-1">Daftar objek perintah (*Check Commands*), kontak, dan jendela waktu (*Time Periods*) terkonfigurasi (*config.cgi*)</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Registered Commands -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center">
        <h3 class="font-bold text-slate-800 text-base">Check Commands</h3>
        <span class="px-2.5 py-0.5 bg-indigo-50 text-indigo-700 text-xs font-semibold rounded-full border border-indigo-100">
          <%= @commands.size %>
        </span>
      </div>

      <div class="p-4 divide-y divide-slate-100 max-h-96 overflow-y-auto">
        <% @commands.each do |cmd| %>
          <div class="py-2 flex items-center justify-between">
            <span class="font-mono text-xs font-semibold text-slate-800"><%= cmd %></span>
            <span class="text-[10px] font-semibold px-2 py-0.5 bg-slate-100 text-slate-600 rounded">COMMAND</span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Registered Contacts -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center">
        <h3 class="font-bold text-slate-800 text-base">Registered Contacts</h3>
        <span class="px-2.5 py-0.5 bg-indigo-50 text-indigo-700 text-xs font-semibold rounded-full border border-indigo-100">
          <%= @contacts.size %>
        </span>
      </div>

      <div class="p-4 divide-y divide-slate-100">
        <% @contacts.each do |contact| %>
          <div class="py-2.5 flex items-center justify-between">
            <div>
              <p class="font-semibold text-slate-800 text-xs"><%= contact %></p>
              <p class="text-[11px] text-slate-400">System Admin</p>
            </div>
            <span class="text-[10px] px-2 py-0.5 bg-emerald-50 text-emerald-800 font-bold border border-emerald-200 rounded-full">ACTIVE</span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Defined Time Periods -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center">
        <h3 class="font-bold text-slate-800 text-base">Defined Time Periods</h3>
        <span class="px-2.5 py-0.5 bg-indigo-50 text-indigo-700 text-xs font-semibold rounded-full border border-indigo-100">
          <%= @timeperiods.size %>
        </span>
      </div>

      <div class="p-4 divide-y divide-slate-100">
        <% @timeperiods.each do |period| %>
          <div class="py-2.5 flex items-center justify-between">
            <div>
              <p class="font-mono text-xs font-bold text-slate-800"><%= period %></p>
              <p class="text-[11px] text-slate-400">Monitoring Window Schedule</p>
            </div>
            <span class="text-[10px] px-2 py-0.5 bg-slate-100 text-slate-700 font-semibold border border-slate-200 rounded">SCHEDULE</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
