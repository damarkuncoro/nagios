<div class="max-w-6xl mx-auto space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Objects Configuration Explorer</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Inspeksi definisi perintah (*Check Commands*), kontak, grup, dan jadwal waktu (*config.cgi*)</p>
    </div>
    <div>
      <%= button_to verify_configuration_path, method: :post, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs tracking-wide rounded-lg shadow-sm hover:shadow transition cursor-pointer" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Pre-Flight Check (<code class="font-mono text-[11px] bg-indigo-700/80 px-1 py-0.5 rounded">nagios -v</code>)</span>
      <% end %>
    </div>
  </div>

  <div id="verification_report_panel">
    <% if defined?(@report) && @report.present? %>
      <%= render "configuration/verification_report", report: @report %>
    <% end %>
  </div>

  <!-- Summary Metric Badges -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="p-4 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Commands</p>
      <p class="text-2xl font-extrabold text-indigo-600 dark:text-indigo-400 mt-1"><%= @commands.size %></p>
      <p class="text-[11px] text-slate-400 dark:text-slate-500">Executable definitions</p>
    </div>
    <div class="p-4 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Contacts</p>
      <p class="text-2xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1"><%= @contacts.size %></p>
      <p class="text-[11px] text-slate-400 dark:text-slate-500">Recipients configured</p>
    </div>
    <div class="p-4 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Contact Groups</p>
      <p class="text-2xl font-extrabold text-sky-600 dark:text-sky-400 mt-1"><%= @contactgroups.size %></p>
      <p class="text-[11px] text-slate-400 dark:text-slate-500">Escalation teams</p>
    </div>
    <div class="p-4 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Time Periods</p>
      <p class="text-2xl font-extrabold text-amber-600 dark:text-amber-400 mt-1"><%= @timeperiods.size %></p>
      <p class="text-[11px] text-slate-400 dark:text-slate-500">Active monitoring windows</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Registered Commands with Full Command Lines -->
    <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs overflow-hidden flex flex-col">
      <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
        <div>
          <h3 class="font-bold text-slate-800 dark:text-slate-200 text-base">Check Commands & Definitions</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">Template command line eksekusi plugin</p>
        </div>
        <span class="px-2.5 py-0.5 bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-400 text-xs font-semibold rounded-full border border-indigo-100 dark:border-indigo-800">
          <%= @commands.size %> Total
        </span>
      </div>

      <div class="p-4 divide-y divide-slate-100 dark:divide-slate-800 overflow-y-auto max-h-[500px] space-y-3">
        <% @commands.each do |cmd| %>
          <% cmd_name = cmd.is_a?(Hash) ? cmd['name'] : cmd %>
          <% cmd_line = cmd.is_a?(Hash) ? cmd['command_line'] : '' %>
          <div class="pt-3 first:pt-0 space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400"><%= cmd_name %></span>
              <span class="text-[10px] font-semibold px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded">COMMAND</span>
            </div>
            <% if cmd_line.present? %>
              <div class="p-2 bg-slate-50 dark:bg-slate-950/60 rounded border border-slate-200/80 dark:border-slate-800 space-y-1">
                <code class="text-[11px] font-mono text-slate-700 dark:text-slate-300 break-all select-all block"><%= cmd_line %></code>
                <% resolved_line = Statuses::Services::MacroResolver.resolve(cmd_line) %>
                <% if resolved_line != cmd_line %>
                  <div class="pt-1 border-t border-slate-200/60 dark:border-slate-800 flex items-start gap-1.5">
                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold shrink-0">Resolved:</span>
                    <code class="text-[10px] font-mono text-emerald-700 dark:text-emerald-300 break-all select-all block"><%= resolved_line %></code>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Contacts & Contact Groups -->
    <div class="space-y-6">
      <!-- Contacts -->
      <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs overflow-hidden">
        <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
          <div>
            <h3 class="font-bold text-slate-800 dark:text-slate-200 text-base">Registered Contacts</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Daftar penerima alert & email tujuan</p>
          </div>
          <span class="px-2.5 py-0.5 bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 text-xs font-semibold rounded-full border border-emerald-100 dark:border-emerald-800">
            <%= @contacts.size %>
          </span>
        </div>

        <div class="p-4 divide-y divide-slate-100 dark:divide-slate-800">
          <% @contacts.each do |contact| %>
            <% c_name = contact.is_a?(Hash) ? contact['name'] : contact %>
            <% c_alias = contact.is_a?(Hash) ? contact['alias'] : '' %>
            <% c_email = contact.is_a?(Hash) ? contact['email'] : '' %>
            <div class="py-3 flex items-center justify-between">
              <div>
                <p class="font-bold text-slate-800 dark:text-slate-200 text-xs"><%= c_name %></p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400"><%= c_alias.presence || "Nagios Contact" %></p>
                <% if c_email.present? %>
                  <p class="text-[11px] font-mono text-indigo-600 dark:text-indigo-400 mt-0.5">✉️ <%= c_email %></p>
                <% end %>
              </div>
              <span class="text-[10px] px-2 py-0.5 bg-emerald-50 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-bold border border-emerald-200 dark:border-emerald-800 rounded-full">ACTIVE</span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Contact Groups -->
      <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs overflow-hidden">
        <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
          <h3 class="font-bold text-slate-800 dark:text-slate-200 text-base">Contact Groups</h3>
          <span class="px-2.5 py-0.5 bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-400 text-xs font-semibold rounded-full border border-sky-100 dark:border-sky-800">
            <%= @contactgroups.size %>
          </span>
        </div>

        <div class="p-4 divide-y divide-slate-100 dark:divide-slate-800">
          <% @contactgroups.each do |cg| %>
            <div class="py-3 space-y-1">
              <div class="flex justify-between items-center">
                <span class="font-bold text-xs text-slate-800 dark:text-slate-200"><%= cg['group_name'] %></span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400"><%= cg['alias'] %></span>
              </div>
              <% members = cg['members'] || [] %>
              <div class="flex flex-wrap gap-1.5 pt-1">
                <% members.each do |m| %>
                  <span class="px-2 py-0.5 text-[10px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded border border-slate-200 dark:border-slate-700">
                    👤 <%= m %>
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Time Periods -->
      <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs overflow-hidden">
        <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
          <h3 class="font-bold text-slate-800 dark:text-slate-200 text-base">Time Periods</h3>
          <span class="px-2.5 py-0.5 bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-400 text-xs font-semibold rounded-full border border-indigo-100 dark:border-amber-800">
            <%= @timeperiods.size %>
          </span>
        </div>

        <div class="p-4 divide-y divide-slate-100 dark:divide-slate-800">
          <% @timeperiods.each do |tp| %>
            <% tp_name = tp.is_a?(Hash) ? tp['name'] : tp %>
            <% tp_alias = tp.is_a?(Hash) ? tp['alias'] : '' %>
            <div class="py-2.5 flex items-center justify-between">
              <div>
                <span class="font-mono text-xs font-semibold text-slate-800 dark:text-slate-200"><%= tp_name %></span>
                <% if tp_alias.present? && tp_alias != tp_name %>
                  <p class="text-[11px] text-slate-400 dark:text-slate-500"><%= tp_alias %></p>
                <% end %>
              </div>
              <span class="text-[10px] font-semibold px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded">WINDOW</span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Resource Macros ($USERx$) -->
      <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs overflow-hidden">
        <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
          <div>
            <h3 class="font-bold text-slate-800 dark:text-slate-200 text-base">Resource Macros</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Path plugin & macro dari <code class="font-mono text-[10px]">resource.cfg</code></p>
          </div>
          <span class="px-2.5 py-0.5 bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 text-xs font-semibold rounded-full border border-emerald-100 dark:border-emerald-800">
            <%= (@user_macros || {}).size %> Defined
          </span>
        </div>

        <div class="p-4 divide-y divide-slate-100 dark:divide-slate-800">
          <% (@user_macros || {}).each do |macro, val| %>
            <div class="py-2.5 flex items-center justify-between gap-2">
              <span class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400"><%= macro %></span>
              <code class="text-[11px] font-mono text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-950 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-800 break-all"><%= val %></code>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
