<div class="max-w-7xl mx-auto space-y-8">
  <!-- Header & Pre-Flight Action -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Configuration Explorer</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
          <span>config.cgi engine</span>
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Inspeksi objek definisi (*config.cgi*), direktif daemon (*nagios.cfg*), dan otorisasi web (*cgi.cfg*)</p>
    </div>
    <div>
      <%= button_to verify_configuration_path, method: :post, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-700 hover:to-indigo-600 text-white font-semibold text-xs tracking-wide rounded-xl shadow-md shadow-indigo-600/20 transition cursor-pointer card-hover" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Pre-Flight Check (<code class="font-mono text-[11px] bg-indigo-700/80 px-1 py-0.5 rounded">nagios -v</code>)</span>
      <% end %>
    </div>
  </div>

  <div id="verification_report_panel">
    <% if defined?(@report) && @report.present? %>
      <%= render "configuration/verification_report", report: @report %>
    <% end %>
  </div>

  <!-- Navigation Tabs -->
  <div class="border-b border-slate-200/80 dark:border-slate-800">
    <nav class="-mb-px flex space-x-6" aria-label="Tabs">
      <%= link_to configuration_path(tab: "objects"), class: "inline-flex items-center gap-2 py-3 px-1 border-b-2 font-medium text-sm transition-colors #{@active_tab == 'objects' ? 'border-indigo-600 text-indigo-600 dark:text-indigo-400 dark:border-indigo-400 font-semibold' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 dark:text-slate-400 dark:hover:text-slate-200'}" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
        <span>Objects Explorer</span>
        <span class="px-2 py-0.5 rounded-full text-xs bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-semibold"><%= @commands.size + @contacts.size + @contactgroups.size + @timeperiods.size %></span>
      <% end %>

      <%= link_to configuration_path(tab: "daemon"), class: "inline-flex items-center gap-2 py-3 px-1 border-b-2 font-medium text-sm transition-colors #{@active_tab == 'daemon' ? 'border-indigo-600 text-indigo-600 dark:text-indigo-400 dark:border-indigo-400 font-semibold' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 dark:text-slate-400 dark:hover:text-slate-200'}" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        <span>Daemon Directives (<code class="text-xs font-mono">nagios.cfg</code>)</span>
        <span class="px-2 py-0.5 rounded-full text-xs bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-semibold"><%= @main_directives.size %></span>
      <% end %>

      <%= link_to configuration_path(tab: "cgi"), class: "inline-flex items-center gap-2 py-3 px-1 border-b-2 font-medium text-sm transition-colors #{@active_tab == 'cgi' ? 'border-indigo-600 text-indigo-600 dark:text-indigo-400 dark:border-indigo-400 font-semibold' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 dark:text-slate-400 dark:hover:text-slate-200'}" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
        <span>Web & CGI Access (<code class="text-xs font-mono">cgi.cfg</code>)</span>
        <span class="px-2 py-0.5 rounded-full text-xs bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-semibold"><%= @cgi_directives.size %></span>
      <% end %>
    </nav>
  </div>

  <% if @active_tab == 'daemon' %>
    <!-- Nagios Core Daemon Directives (nagios.cfg) -->
    <div class="space-y-8" data-controller="daemon-filter">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 to-violet-500"></div>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Total Directives</p>
          <p class="text-3xl font-extrabold text-indigo-600 dark:text-indigo-400 mt-2 font-mono"><%= @main_directives.size %></p>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Parsed nagios.cfg keys</p>
        </div>
        <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 to-orange-500"></div>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Service Timeout</p>
          <p class="text-3xl font-extrabold text-amber-600 dark:text-amber-400 mt-2 font-mono"><%= @main_directives['service_check_timeout'] || 60 %>s</p>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Host timeout: <%= @main_directives['host_check_timeout'] || 30 %>s</p>
        </div>
        <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-500"></div>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Flap Detection</p>
          <p class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-2 font-mono"><%= @main_directives['enable_flap_detection'] ? 'ACTIVE' : 'OFF' %></p>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Service: <%= @main_directives['low_service_flap_threshold'] %>% / <%= @main_directives['high_service_flap_threshold'] %>%</p>
        </div>
        <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-sky-500 to-blue-500"></div>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Performance Data</p>
          <p class="text-3xl font-extrabold text-sky-600 dark:text-sky-400 mt-2 font-mono"><%= @main_directives['process_performance_data'] ? 'ENABLED' : 'DISABLED' %></p>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">OpenMetrics & Spooling</p>
        </div>
      </div>

      <!-- Core Engine Controls & Paths -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
          <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-200/80 dark:border-slate-800 flex items-center justify-between">
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-base">Core Daemon Paths & Spools</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">File lokasi log, cache objek, state retention, dan command pipe</p>
            </div>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          </div>
          <div class="p-5 divide-y divide-slate-100 dark:divide-slate-800/80">
            <% %w[log_file cfg_file resource_file status_file state_retention_file command_file check_result_path object_cache_file].each do |k| %>
              <% val = @main_directives[k] %>
              <div class="py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <span class="font-mono text-xs font-semibold text-slate-700 dark:text-slate-300"><%= k %></span>
                <% if val.is_a?(Array) %>
                  <div class="flex flex-col gap-1 items-end">
                    <% val.each do |v| %>
                      <code class="text-[11px] font-mono text-indigo-600 dark:text-indigo-400 bg-slate-50 dark:bg-slate-950 px-2 py-0.5 rounded-lg border border-slate-200/80 dark:border-slate-800"><%= v %></code>
                    <% end %>
                  </div>
                <% elsif val.present? %>
                  <code class="text-[11px] font-mono text-indigo-600 dark:text-indigo-400 bg-slate-50 dark:bg-slate-950 px-2 py-0.5 rounded-lg border border-slate-200/80 dark:border-slate-800 break-all"><%= val %></code>
                <% else %>
                  <span class="text-xs text-slate-400 italic">default / unspecified</span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
          <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-200/80 dark:border-slate-800 flex items-center justify-between">
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-base">Execution Intervals & Timeouts</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">Parameter interval polling, reaper cycle, dan timeout limit</p>
            </div>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          </div>
          <div class="p-5 divide-y divide-slate-100 dark:divide-slate-800/80">
            <% %w[interval_length service_check_timeout host_check_timeout event_handler_timeout notification_timeout check_result_reaper_frequency max_check_result_reaper_time status_update_interval retention_update_interval].each do |k| %>
              <% val = @main_directives[k] %>
              <div class="py-2.5 flex items-center justify-between">
                <span class="font-mono text-xs font-semibold text-slate-700 dark:text-slate-300"><%= k %></span>
                <span class="font-mono text-xs font-bold px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200/50 dark:border-slate-700">
                  <%= val.present? ? "#{val}#{k.include?('timeout') || k.include?('frequency') || k.include?('time') || k.include?('interval') ? 's' : ''}" : 'default' %>
                </span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- All Directives Table with Instant Filter -->
      <div class="glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
        <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-200/80 dark:border-slate-800 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base">Parsed nagios.cfg Directives</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Daftar lengkap konfigurasi daemon dari <code class="font-mono text-[10px]">Statuses::Services::MainConfigParser</code></p>
          </div>
          <div class="flex items-center gap-2.5 w-full sm:w-auto">
            <div class="relative w-full sm:w-64">
              <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              <input type="text" id="daemon-filter-input" placeholder="Search directive..." class="w-full pl-9 pr-3 py-1.5 text-xs rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" oninput="filterDirectives(this.value, 'daemon-directives-list')">
            </div>
            <span class="px-2.5 py-1 bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-400 text-xs font-semibold rounded-xl border border-indigo-100 dark:border-indigo-800 shrink-0">
              <%= @main_directives.size %> Directives
            </span>
          </div>
        </div>
        <div id="daemon-directives-list" class="p-4 divide-y divide-slate-100 dark:divide-slate-800/80 overflow-y-auto max-h-[600px]">
          <% @main_directives.sort.each do |key, val| %>
            <div class="py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 directive-row hover:bg-slate-50/50 dark:hover:bg-slate-800/40 px-2 rounded-lg transition" data-key="<%= key.to_s.downcase %>" data-val="<%= val.to_s.downcase %>">
              <span class="font-mono text-xs font-semibold text-slate-800 dark:text-slate-200"><%= key %></span>
              <div class="text-right">
                <% if val.is_a?(Array) %>
                  <div class="flex flex-col gap-0.5 items-end">
                    <% val.each do |v| %>
                      <code class="text-[11px] font-mono text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-950 px-2 py-0.5 rounded-lg border border-slate-200/80 dark:border-slate-800"><%= v %></code>
                    <% end %>
                  </div>
                <% elsif val.is_a?(TrueClass) || val.is_a?(FalseClass) %>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-md <%= val ? 'bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800' : 'bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400' %>">
                    <%= val ? 'ENABLED (1)' : 'DISABLED (0)' %>
                  </span>
                <% else %>
                  <code class="text-[11px] font-mono text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-950 px-2 py-0.5 rounded-lg border border-slate-200/80 dark:border-slate-800 break-all"><%= val %></code>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  <% elsif @active_tab == 'cgi' %>
    <!-- Web & CGI Access Directives (cgi.cfg) -->
    <div class="space-y-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 to-violet-500"></div>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">CGI Directives</p>
          <p class="text-3xl font-extrabold text-indigo-600 dark:text-indigo-400 mt-2 font-mono"><%= @cgi_directives.size %></p>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Parsed cgi.cfg keys</p>
        </div>
        <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 to-orange-500"></div>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Refresh Rate</p>
          <p class="text-3xl font-extrabold text-amber-600 dark:text-amber-400 mt-2 font-mono"><%= @cgi_directives['refresh_rate'] || 90 %>s</p>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1"><%= Statuses::Services::CgiConfigParser.format_interval(@cgi_directives['refresh_rate'] || 90) %></p>
        </div>
        <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-500"></div>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Authentication</p>
          <p class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-2 font-mono"><%= @cgi_directives['use_authentication'] ? 'ACTIVE' : 'OFF' %></p>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">SSL: <%= @cgi_directives['use_ssl_authentication'] ? 'YES' : 'NO' %></p>
        </div>
        <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-sky-500 to-blue-500"></div>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">HTML Escaping</p>
          <p class="text-3xl font-extrabold text-sky-600 dark:text-sky-400 mt-2 font-mono"><%= @cgi_directives['escape_html_tags'] ? 'SECURED' : 'RAW' %></p>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Plugin output sanitizer</p>
        </div>
      </div>

      <!-- Role-Based Authorization Matrix -->
      <div class="glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
        <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-200/80 dark:border-slate-800 flex items-center justify-between">
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base">Contact Authorization Matrix</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Hak akses kontak untuk inspeksi sistem dan eksekusi perintah CGI (*cgi/cgiauth.c*)</p>
          </div>
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            RBAC Profile
          </span>
        </div>
        <div class="p-5 divide-y divide-slate-100 dark:divide-slate-800/80">
          <% Statuses::Services::CgiConfigParser::CONTACT_LIST_DIRECTIVES.each do |directive| %>
            <% contacts = @cgi_parser ? @cgi_parser.authorized_contacts_for(directive) : (@cgi_directives[directive] || []) %>
            <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-slate-50/40 dark:hover:bg-slate-800/30 px-2 rounded-lg transition">
              <div>
                <span class="font-mono text-xs font-bold text-slate-900 dark:text-white"><%= directive %></span>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">
                  <% case directive %>
                  <% when 'authorized_for_system_information' %>
                    Akses ringkasan performa daemon dan process info
                  <% when 'authorized_for_configuration_information' %>
                    Akses inspeksi konfigurasi objek dan direktif engine
                  <% when 'authorized_for_system_commands' %>
                    Izin eksekusi perintah shutdown, restart, dan process toggle
                  <% when 'authorized_for_all_hosts' %>
                    Izin melihat seluruh status host tanpa pembatasan kontak
                  <% when 'authorized_for_all_services' %>
                    Izin melihat seluruh status service tanpa pembatasan kontak
                  <% when 'authorized_for_all_host_commands' %>
                    Izin eksekusi perintah pada seluruh host (recheck, downtime, ACK)
                  <% when 'authorized_for_all_service_commands' %>
                    Izin eksekusi perintah pada seluruh service
                  <% when 'authorized_for_read_only' %>
                    Profil hanya baca (read-only viewer)
                  <% end %>
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5 justify-end">
                <% if contacts.any? %>
                  <% contacts.each do |c| %>
                    <span class="px-2.5 py-1 text-[11px] font-semibold bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-400 rounded-lg border border-indigo-100 dark:border-indigo-800/80">
                      👤 <%= c %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-xs text-slate-400 italic">none (restricted)</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- All CGI Directives Table -->
      <div class="glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
        <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-200/80 dark:border-slate-800 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base">Parsed cgi.cfg Directives</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Daftar lengkap konfigurasi CGI dari <code class="font-mono text-[10px]">Statuses::Services::CgiConfigParser</code></p>
          </div>
          <div class="flex items-center gap-2.5 w-full sm:w-auto">
            <div class="relative w-full sm:w-64">
              <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              <input type="text" id="cgi-filter-input" placeholder="Search CGI directive..." class="w-full pl-9 pr-3 py-1.5 text-xs rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition" oninput="filterDirectives(this.value, 'cgi-directives-list')">
            </div>
            <span class="px-2.5 py-1 bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 text-xs font-semibold rounded-xl border border-emerald-100 dark:border-emerald-800 shrink-0">
              <%= @cgi_directives.size %> Directives
            </span>
          </div>
        </div>
        <div id="cgi-directives-list" class="p-4 divide-y divide-slate-100 dark:divide-slate-800/80 overflow-y-auto max-h-[600px]">
          <% @cgi_directives.sort.each do |key, val| %>
            <div class="py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 directive-row hover:bg-slate-50/50 dark:hover:bg-slate-800/40 px-2 rounded-lg transition" data-key="<%= key.to_s.downcase %>" data-val="<%= val.to_s.downcase %>">
              <span class="font-mono text-xs font-semibold text-slate-800 dark:text-slate-200"><%= key %></span>
              <div class="text-right">
                <% if val.is_a?(Array) %>
                  <div class="flex flex-wrap gap-1 justify-end">
                    <% val.each do |v| %>
                      <code class="text-[11px] font-mono text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-950 px-2 py-0.5 rounded-lg border border-slate-200/80 dark:border-slate-800"><%= v %></code>
                    <% end %>
                  </div>
                <% elsif val.is_a?(TrueClass) || val.is_a?(FalseClass) %>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-md <%= val ? 'bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800' : 'bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400' %>">
                    <%= val ? 'ENABLED (1)' : 'DISABLED (0)' %>
                  </span>
                <% else %>
                  <code class="text-[11px] font-mono text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-950 px-2 py-0.5 rounded-lg border border-slate-200/80 dark:border-slate-800 break-all"><%= val %></code>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  <% else %>
    <!-- Objects Explorer (Default) -->
    <!-- Summary Metric Badges -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 to-violet-500"></div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Commands</p>
        <p class="text-3xl font-extrabold text-indigo-600 dark:text-indigo-400 mt-2 font-mono"><%= @commands.size %></p>
        <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Executable definitions</p>
      </div>
      <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-500"></div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Contacts</p>
        <p class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-2 font-mono"><%= @contacts.size %></p>
        <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Recipients configured</p>
      </div>
      <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-sky-500 to-blue-500"></div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Contact Groups</p>
        <p class="text-3xl font-extrabold text-sky-600 dark:text-sky-400 mt-2 font-mono"><%= @contactgroups.size %></p>
        <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Escalation teams</p>
      </div>
      <div class="p-5 glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 to-orange-500"></div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Time Periods</p>
        <p class="text-3xl font-extrabold text-amber-600 dark:text-amber-400 mt-2 font-mono"><%= @timeperiods.size %></p>
        <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-1">Active monitoring windows</p>
      </div>
    </div>

    <!-- Live Search for Objects -->
    <div class="glass-panel bg-white dark:bg-[#111827] p-3.5 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs flex items-center gap-3">
      <svg class="w-4 h-4 text-slate-400 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      <input type="text" id="objects-filter-input" placeholder="Quick filter check commands, contacts, groups, or time periods..." class="w-full bg-transparent text-xs text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none" oninput="filterObjects(this.value)">
      <button onclick="document.getElementById('objects-filter-input').value = ''; filterObjects('')" class="text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 px-2 py-1 rounded-lg">Clear</button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Registered Commands with Full Command Lines -->
      <div class="glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden flex flex-col card-hover">
        <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-200/80 dark:border-slate-800 flex justify-between items-center">
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base">Check Commands & Definitions</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Template command line eksekusi plugin</p>
          </div>
          <span class="px-2.5 py-1 bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-400 text-xs font-semibold rounded-xl border border-indigo-100 dark:border-indigo-800">
            <%= @commands.size %> Total
          </span>
        </div>

        <div id="commands-list" class="p-5 divide-y divide-slate-100 dark:divide-slate-800/80 overflow-y-auto max-h-[550px] space-y-3">
          <% @commands.each do |cmd| %>
            <% cmd_name = cmd.is_a?(Hash) ? cmd['name'] : cmd %>
            <% cmd_line = cmd.is_a?(Hash) ? cmd['command_line'] : '' %>
            <div class="pt-3 first:pt-0 space-y-1.5 command-item" data-search="<%= "#{cmd_name} #{cmd_line}".downcase %>">
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400"><%= cmd_name %></span>
                <span class="text-[10px] font-semibold px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-md">COMMAND</span>
              </div>
              <% if cmd_line.present? %>
                <div class="p-3 bg-slate-50/80 dark:bg-slate-950/70 rounded-xl border border-slate-200/80 dark:border-slate-800/80 space-y-2 relative group">
                  <div class="flex items-start justify-between gap-2">
                    <code class="text-[11px] font-mono text-slate-700 dark:text-slate-300 break-all select-all block"><%= cmd_line %></code>
                    <button type="button" onclick="navigator.clipboard.writeText('<%= j(cmd_line) %>'); this.innerText = 'Copied!'; setTimeout(() => this.innerText = 'Copy', 1500);" class="shrink-0 text-[10px] font-semibold px-2 py-1 rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 shadow-2xs transition cursor-pointer">
                      Copy
                    </button>
                  </div>
                  <% resolved_line = Statuses::Services::MacroResolver.resolve(cmd_line) %>
                  <% if resolved_line != cmd_line %>
                    <div class="pt-2 border-t border-slate-200/60 dark:border-slate-800 flex items-start gap-1.5">
                      <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold shrink-0">Resolved:</span>
                      <code class="text-[10px] font-mono text-emerald-700 dark:text-emerald-300 break-all select-all block"><%= resolved_line %></code>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Contacts & Contact Groups -->
      <div class="space-y-6">
        <!-- Contacts -->
        <div class="glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
          <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-200/80 dark:border-slate-800 flex justify-between items-center">
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-base">Registered Contacts</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">Daftar penerima alert & email tujuan</p>
            </div>
            <span class="px-2.5 py-1 bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 text-xs font-semibold rounded-xl border border-emerald-100 dark:border-emerald-800">
              <%= @contacts.size %>
            </span>
          </div>

          <div id="contacts-list" class="p-5 divide-y divide-slate-100 dark:divide-slate-800/80">
            <% @contacts.each do |contact| %>
              <% c_name = contact.is_a?(Hash) ? contact['name'] : contact %>
              <% c_alias = contact.is_a?(Hash) ? contact['alias'] : '' %>
              <% c_email = contact.is_a?(Hash) ? contact['email'] : '' %>
              <div class="py-3 flex items-center justify-between contact-item" data-search="<%= "#{c_name} #{c_alias} #{c_email}".downcase %>">
                <div>
                  <p class="font-bold text-slate-850 dark:text-slate-150 text-xs"><%= c_name %></p>
                  <p class="text-[11px] text-slate-500 dark:text-slate-400"><%= c_alias.presence || "Nagios Contact" %></p>
                  <% if c_email.present? %>
                    <p class="text-[11px] font-mono text-indigo-600 dark:text-indigo-400 mt-0.5">✉️ <%= c_email %></p>
                  <% end %>
                </div>
                <span class="text-[10px] px-2 py-0.5 bg-emerald-50 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-bold border border-emerald-200 dark:border-emerald-800 rounded-full">ACTIVE</span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Contact Groups -->
        <div class="glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
          <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-200/80 dark:border-slate-800 flex justify-between items-center">
            <h3 class="font-bold text-slate-900 dark:text-white text-base">Contact Groups</h3>
            <span class="px-2.5 py-1 bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-400 text-xs font-semibold rounded-xl border border-sky-100 dark:border-sky-800">
              <%= @contactgroups.size %>
            </span>
          </div>

          <div id="contactgroups-list" class="p-5 divide-y divide-slate-100 dark:divide-slate-800/80">
            <% @contactgroups.each do |cg| %>
              <div class="py-3 space-y-1.5 contactgroup-item" data-search="<%= "#{cg['group_name']} #{cg['alias']} #{(cg['members'] || []).join(' ')}".downcase %>">
                <div class="flex justify-between items-center">
                  <span class="font-bold text-xs text-slate-800 dark:text-slate-200"><%= cg['group_name'] %></span>
                  <span class="text-[11px] text-slate-500 dark:text-slate-400"><%= cg['alias'] %></span>
                </div>
                <% members = cg['members'] || [] %>
                <div class="flex flex-wrap gap-1.5 pt-1">
                  <% members.each do |m| %>
                    <span class="px-2 py-0.5 text-[10px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-md border border-slate-200/60 dark:border-slate-700">
                      👤 <%= m %>
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Time Periods -->
        <div class="glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
          <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-200/80 dark:border-slate-800 flex justify-between items-center">
            <h3 class="font-bold text-slate-900 dark:text-white text-base">Time Periods</h3>
            <span class="px-2.5 py-1 bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-400 text-xs font-semibold rounded-xl border border-amber-100 dark:border-amber-800">
              <%= @timeperiods.size %>
            </span>
          </div>

          <div id="timeperiods-list" class="p-5 divide-y divide-slate-100 dark:divide-slate-800/80">
            <% @timeperiods.each do |tp| %>
              <% tp_name = tp.is_a?(Hash) ? tp['name'] : tp %>
              <% tp_alias = tp.is_a?(Hash) ? tp['alias'] : '' %>
              <div class="py-2.5 flex items-center justify-between timeperiod-item" data-search="<%= "#{tp_name} #{tp_alias}".downcase %>">
                <div>
                  <span class="font-mono text-xs font-semibold text-slate-800 dark:text-slate-200"><%= tp_name %></span>
                  <% if tp_alias.present? && tp_alias != tp_name %>
                    <p class="text-[11px] text-slate-400 dark:text-slate-500"><%= tp_alias %></p>
                  <% end %>
                </div>
                <span class="text-[10px] font-semibold px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-md">WINDOW</span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Resource Macros ($USERx$) -->
        <div class="glass-panel bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
          <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-200/80 dark:border-slate-800 flex justify-between items-center">
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-base">Resource Macros</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">Path plugin & macro dari <code class="font-mono text-[10px]">resource.cfg</code></p>
            </div>
            <span class="px-2.5 py-1 bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 text-xs font-semibold rounded-xl border border-emerald-100 dark:border-emerald-800">
              <%= (@user_macros || {}).size %> Defined
            </span>
          </div>

          <div class="p-5 divide-y divide-slate-100 dark:divide-slate-800/80">
            <% (@user_macros || {}).each do |macro, val| %>
              <div class="py-2.5 flex items-center justify-between gap-2">
                <span class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400"><%= macro %></span>
                <code class="text-[11px] font-mono text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-950 px-2 py-0.5 rounded-lg border border-slate-200/80 dark:border-slate-800 break-all"><%= val %></code>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
  function filterDirectives(query, containerId) {
    const q = (query || '').toLowerCase().trim();
    const container = document.getElementById(containerId);
    if (!container) return;
    const rows = container.querySelectorAll('.directive-row');
    rows.forEach(row => {
      const key = row.getAttribute('data-key') || '';
      const val = row.getAttribute('data-val') || '';
      if (!q || key.includes(q) || val.includes(q)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function filterObjects(query) {
    const q = (query || '').toLowerCase().trim();
    const classes = ['.command-item', '.contact-item', '.contactgroup-item', '.timeperiod-item'];
    classes.forEach(cls => {
      document.querySelectorAll(cls).forEach(el => {
        const text = el.getAttribute('data-search') || el.innerText.toLowerCase();
        if (!q || text.includes(q)) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  }
</script>
