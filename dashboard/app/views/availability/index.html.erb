<div class="max-w-7xl mx-auto space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Availability & SLA Reports</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20">
          Uptime Metrics
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Laporan pencapaian SLA dan ketersediaan layanan (<span class="font-mono text-xs">avail.cgi</span>)</p>
    </div>

    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2 px-3.5 py-2 glass-panel border border-slate-200/80 dark:border-slate-800/80 rounded-xl text-xs font-semibold">
        <span class="text-slate-500 dark:text-slate-400">Target SLA 99.0%:</span>
        <span class="<%= @report[:overall_sla_pct] >= 99.0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400' %> font-black font-mono"><%= @report[:overall_sla_pct] %>% Met</span>
      </div>

      <%= link_to availability_path(format: :csv), class: "flex items-center gap-2 px-4 py-2 bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 text-white font-medium text-xs rounded-xl border border-slate-700/80 transition cursor-pointer shadow-2xs" do %>
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        <span>Export CSV</span>
      <% end %>
    </div>
  </div>

  <!-- Overall SLA Gauge Card -->
  <div class="glass-panel p-6 sm:p-8 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 card-hover">
    <div class="space-y-2">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 24h Aggregated Telemetry
      </div>
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Overall Infrastructure Availability</h2>
      <p class="text-5xl font-black text-slate-900 dark:text-white tracking-tight font-mono"><%= @report[:overall_sla_pct] %>%</p>
      <p class="text-xs text-slate-500 dark:text-slate-400">Persentase ketersediaan seluruh host dan service dalam siklus 24 jam terakhir</p>
    </div>

    <!-- Radial SVG Ring -->
    <div class="relative w-28 h-28 flex items-center justify-center shrink-0">
      <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="40" stroke="currentColor" stroke-width="8" class="text-slate-100 dark:text-slate-800/80" fill="transparent"/>
        <% stroke_dash = ((@report[:overall_sla_pct].to_f / 100.0) * 251.2).round(1) %>
        <circle cx="50" cy="50" r="40" stroke="currentColor" stroke-width="8" stroke-dasharray="251.2" stroke-dashoffset="<%= 251.2 - stroke_dash %>" stroke-linecap="round" class="<%= @report[:overall_sla_pct] >= 99.0 ? 'text-emerald-500' : 'text-amber-500' %> transition-all duration-1000 ease-out" fill="transparent"/>
      </svg>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <span class="text-lg font-black font-mono text-slate-800 dark:text-slate-100"><%= @report[:overall_sla_pct] %>%</span>
        <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">Uptime</span>
      </div>
    </div>
  </div>

  <!-- Hosts Availability Table -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-slate-800 dark:text-slate-200">Hosts Availability (SLA)</h2>
      <span class="text-xs text-slate-400 font-mono"><%= @report[:host_reports].size %> hosts evaluated</span>
    </div>
    
    <div class="glass-panel rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50/50 dark:bg-slate-800/30 border-b border-slate-200/80 dark:border-slate-800/80 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              <th class="py-3.5 px-6">Host Name</th>
              <th class="py-3.5 px-6">Status Saat Ini</th>
              <th class="py-3.5 px-6">24h Availability</th>
              <th class="py-3.5 px-6 text-right">SLA Compliance</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
            <% @report[:host_reports].each do |hr| %>
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                <td class="py-4 px-6 font-semibold text-slate-800 dark:text-slate-200 text-sm">
                  <%= link_to hr[:name], host_path(hr[:name]), class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 hover:underline transition" %>
                </td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold <%= hr[:status] == 'UP' ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= hr[:status] == 'UP' ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
                    <%= hr[:status] %>
                  </span>
                </td>
                <td class="py-4 px-6">
                  <div class="w-48 space-y-1.5">
                    <div class="flex justify-between items-center text-xs font-semibold text-slate-700 dark:text-slate-300 font-mono">
                      <span><%= hr[:availability_pct] %>%</span>
                      <span class="text-[10px] text-slate-400">uptime</span>
                    </div>
                    <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden border border-slate-200/50 dark:border-slate-700/50">
                      <div class="h-full <%= hr[:availability_pct] >= 99.0 ? 'bg-emerald-500' : 'bg-rose-500' %> transition-all duration-500" style="width: <%= hr[:availability_pct] %>%"></div>
                    </div>
                  </div>
                </td>
                <td class="py-4 px-6 text-right">
                  <span class="px-3 py-1 rounded-full text-xs font-bold font-mono border <%= hr[:sla_met] ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/20' : 'bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20' %>">
                    <%= hr[:sla_met] ? 'SLA PASSED' : 'SLA BREACHED' %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Services Availability Table -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-slate-800 dark:text-slate-200">Services Availability (SLA)</h2>
      <span class="text-xs text-slate-400 font-mono"><%= @report[:service_reports].size %> services evaluated</span>
    </div>

    <div class="glass-panel rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50/50 dark:bg-slate-800/30 border-b border-slate-200/80 dark:border-slate-800/80 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              <th class="py-3.5 px-6">Host</th>
              <th class="py-3.5 px-6">Service</th>
              <th class="py-3.5 px-6">Status Saat Ini</th>
              <th class="py-3.5 px-6">24h Availability</th>
              <th class="py-3.5 px-6 text-right">SLA Compliance</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
            <% @report[:service_reports].each do |sr| %>
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                <td class="py-4 px-6 text-sm text-slate-500 dark:text-slate-400 font-medium font-mono">
                  <%= sr[:host_name] %>
                </td>
                <td class="py-4 px-6 font-semibold text-slate-800 dark:text-slate-200 text-sm">
                  <%= sr[:description] %>
                </td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold <%= sr[:status] == 'OK' ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20' : 'bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= sr[:status] == 'OK' ? 'bg-emerald-500' : 'bg-amber-500' %>"></span>
                    <%= sr[:status] %>
                  </span>
                </td>
                <td class="py-4 px-6">
                  <div class="w-48 space-y-1.5">
                    <div class="flex justify-between items-center text-xs font-semibold text-slate-700 dark:text-slate-300 font-mono">
                      <span><%= sr[:availability_pct] %>%</span>
                      <span class="text-[10px] text-slate-400">uptime</span>
                    </div>
                    <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden border border-slate-200/50 dark:border-slate-700/50">
                      <div class="h-full <%= sr[:availability_pct] >= 99.0 ? 'bg-emerald-500' : 'bg-amber-500' %> transition-all duration-500" style="width: <%= sr[:availability_pct] %>%"></div>
                    </div>
                  </div>
                </td>
                <td class="py-4 px-6 text-right">
                  <span class="px-3 py-1 rounded-full text-xs font-bold font-mono border <%= sr[:sla_met] ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20' : 'bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20' %>">
                    <%= sr[:sla_met] ? 'SLA PASSED' : 'SLA WARNING' %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
