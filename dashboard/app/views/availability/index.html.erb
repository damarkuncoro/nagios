<div class="max-w-6xl mx-auto space-y-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Availability & SLA Reports</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Laporan pencapaian SLA dan ketersediaan layanan (*avail.cgi*)</p>
    </div>

    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2 px-3.5 py-2 bg-emerald-50 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 rounded-lg text-xs font-semibold">
        <span>Target SLA 99.0%:</span>
        <span class="text-emerald-700 dark:text-emerald-400 font-extrabold"><%= @report[:overall_sla_pct] %>% Met</span>
      </div>

      <%= link_to availability_path(format: :csv), class: "flex items-center gap-2 px-4 py-2 bg-slate-900 dark:bg-slate-800 hover:bg-slate-800 text-white font-medium text-xs rounded-lg border border-slate-700 transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        Export CSV
      <% end %>
    </div>
  </div>

  <!-- Overall SLA Gauge Card -->
  <div class="p-6 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Overall Infrastructure Availability</p>
      <p class="text-4xl font-extrabold text-slate-900 dark:text-white mt-2"><%= @report[:overall_sla_pct] %>%</p>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Persentase ketersediaan seluruh host dan service dalam 24 jam terakhir</p>
    </div>

    <div class="w-20 h-20 rounded-full border-8 <%= @report[:overall_sla_pct] >= 99.0 ? 'border-emerald-500 text-emerald-600 dark:text-emerald-400' : 'border-amber-500 text-amber-600 dark:text-amber-400' %> flex items-center justify-center font-black text-lg">
      <%= @report[:overall_sla_pct] %>%
    </div>
  </div>

  <!-- Hosts Availability Table -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-slate-800 dark:text-slate-200">Hosts Availability (SLA)</h2>
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-6">Host Name</th>
            <th class="py-3.5 px-6">Status Saat Ini</th>
            <th class="py-3.5 px-6">24h Availability</th>
            <th class="py-3.5 px-6 text-right">SLA Compliance</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <% @report[:host_reports].each do |hr| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
              <td class="py-4 px-6 font-semibold text-slate-800 dark:text-slate-200 text-sm">
                <%= link_to hr[:name], host_path(hr[:name]), class: "hover:text-indigo-600 dark:hover:text-indigo-400 hover:underline" %>
              </td>
              <td class="py-4 px-6">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold <%= hr[:status] == 'UP' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300' %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= hr[:status] == 'UP' ? 'bg-emerald-500' : 'bg-rose-500' %>"></span> <%= hr[:status] %>
                </span>
              </td>
              <td class="py-4 px-6">
                <div class="w-48 space-y-1">
                  <p class="text-xs font-semibold text-slate-700 dark:text-slate-300"><%= hr[:availability_pct] %>% Uptime</p>
                  <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden border border-slate-200 dark:border-slate-700">
                    <div class="h-full <%= hr[:availability_pct] >= 99.0 ? 'bg-emerald-500' : 'bg-rose-500' %>" style="width: <%= hr[:availability_pct] %>%"></div>
                  </div>
                </div>
              </td>
              <td class="py-4 px-6 text-right">
                <span class="px-2.5 py-1 rounded-md text-xs font-bold <%= hr[:sla_met] ? 'bg-emerald-50 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800' : 'bg-rose-50 dark:bg-rose-950/70 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800' %>">
                  <%= hr[:sla_met] ? 'SLA PASSED' : 'SLA BREACHED' %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Services Availability Table -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-slate-800 dark:text-slate-200">Services Availability (SLA)</h2>
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-6">Host</th>
            <th class="py-3.5 px-6">Service</th>
            <th class="py-3.5 px-6">Status Saat Ini</th>
            <th class="py-3.5 px-6">24h Availability</th>
            <th class="py-3.5 px-6 text-right">SLA Compliance</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <% @report[:service_reports].each do |sr| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
              <td class="py-4 px-6 text-sm text-slate-500 dark:text-slate-400 font-medium">
                <%= sr[:host_name] %>
              </td>
              <td class="py-4 px-6 font-semibold text-slate-800 dark:text-slate-200 text-sm">
                <%= sr[:description] %>
              </td>
              <td class="py-4 px-6">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold <%= sr[:status] == 'OK' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300' %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= sr[:status] == 'OK' ? 'bg-emerald-500' : 'bg-amber-500' %>"></span> <%= sr[:status] %>
                </span>
              </td>
              <td class="py-4 px-6">
                <div class="w-48 space-y-1">
                  <p class="text-xs font-semibold text-slate-700 dark:text-slate-300"><%= sr[:availability_pct] %>% Uptime</p>
                  <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden border border-slate-200 dark:border-slate-700">
                    <div class="h-full <%= sr[:availability_pct] >= 99.0 ? 'bg-emerald-500' : 'bg-amber-500' %>" style="width: <%= sr[:availability_pct] %>%"></div>
                  </div>
                </div>
              </td>
              <td class="py-4 px-6 text-right">
                <span class="px-2.5 py-1 rounded-md text-xs font-bold <%= sr[:sla_met] ? 'bg-emerald-50 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800' : 'bg-amber-50 dark:bg-amber-950/70 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800' %>">
                  <%= sr[:sla_met] ? 'SLA PASSED' : 'SLA WARNING' %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
