<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="max-w-6xl mx-auto p-6 space-y-8">
  <!-- Breadcrumb & Header -->
  <div class="space-y-2">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-400">
      <%= link_to "Dashboard", root_path, class: "hover:text-indigo-600 transition" %>
      <span>/</span>
      <span class="text-slate-700">Host Detail</span>
    </div>

    <div class="flex justify-between items-center">
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight"><%= @host[:name] %></h1>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold <%= @host[:status] == 'UP' ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-red-100 text-red-800 border border-red-200' %>">
          ● <%= @host[:status] %>
        </span>
      </div>

      <%= button_to recheck_host_path(@host[:name]), method: :post, class: "flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs rounded-lg transition cursor-pointer" do %>
        Force Re-check Host
      <% end %>
    </div>
  </div>

  <!-- Host Overview Card -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Plugin Output</p>
      <p class="text-sm font-semibold text-slate-800 mt-1 font-mono"><%= @host[:plugin_output].presence || "-" %></p>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Terakhir Dicek</p>
      <p class="text-sm font-semibold text-slate-800 mt-1"><%= @host[:last_check] ? @host[:last_check].strftime("%H:%M:%S (%d %b %Y)") : "-" %></p>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Check Attempt</p>
      <p class="text-sm font-semibold text-slate-800 mt-1"><%= @host[:current_attempt] %> / <%= @host[:max_attempts] %></p>
    </div>
  </div>

  <!-- Realtime Performance Graph Chart.js Card -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-4">
    <div class="flex justify-between items-center">
      <div>
        <h3 class="font-bold text-slate-800 text-lg">Performance Metrics & Latency Trend</h3>
        <p class="text-xs text-slate-500">Grafik perbandingan latensi PING dan histori eksekusi check</p>
      </div>
      <span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 text-xs font-bold rounded-full border border-indigo-100">Chart.js Live</span>
    </div>

    <div class="h-64 w-full">
      <canvas id="perfChart"></canvas>
    </div>
  </div>

  <!-- Monitored Services List -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-slate-800">Layanan Monitored (<%= @services.size %>)</h2>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
            <th class="py-3.5 px-6">Service Description</th>
            <th class="py-3.5 px-6">Status</th>
            <th class="py-3.5 px-6">Plugin Output</th>
            <th class="py-3.5 px-6">Terakhir Dicek</th>
            <th class="py-3.5 px-6 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if @services.empty? %>
            <tr>
              <td colspan="5" class="py-8 px-6 text-center text-slate-400">
                Tidak ada service terdaftar pada host ini.
              </td>
            </tr>
          <% else %>
            <% @services.each do |service| %>
              <%= render "hosts/service_row", service: service %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var ctx = document.getElementById('perfChart').getContext('2d');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['09:00', '09:05', '09:10', '09:15', '09:20', '09:25', '09:30'],
        datasets: [{
          label: 'PING Latency (ms)',
          data: [0.08, 0.06, 0.05, 0.07, 0.06, 0.05, 0.06],
          borderColor: '#6366F1',
          backgroundColor: 'rgba(99, 102, 241, 0.1)',
          fill: true,
          tension: 0.4
        }, {
          label: 'Service Execution Time (s)',
          data: [0.01, 0.02, 0.01, 0.01, 0.03, 0.01, 0.01],
          borderColor: '#10B981',
          backgroundColor: 'rgba(16, 185, 129, 0.1)',
          fill: true,
          tension: 0.4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' }
        },
        scales: {
          y: { beginAtZero: true }
        }
      }
    });
  });
</script>
