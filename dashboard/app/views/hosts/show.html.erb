<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="max-w-7xl mx-auto space-y-8">
  <!-- Breadcrumb & Header -->
  <div class="space-y-3">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 dark:text-slate-500">
      <%= link_to "Dashboard", root_path, class: "hover:text-indigo-600 dark:hover:text-indigo-400 transition" %>
      <span>/</span>
      <span class="text-slate-700 dark:text-slate-300">Host Detail</span>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight font-mono"><%= @host[:name] %></h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold <%= @host[:status] == 'UP' ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20' %> font-mono">
          <span class="w-2 h-2 rounded-full <%= @host[:status] == 'UP' ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500 animate-ping' %>"></span>
          <span><%= @host[:status] %></span>
        </span>
        <% if @host[:acknowledged] %>
          <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-extrabold uppercase bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/20">
            ACK
          </span>
        <% end %>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <% if %w[DOWN UNREACHABLE].include?(@host[:status]) && !@host[:acknowledged] %>
          <%= button_to acknowledge_host_path(@host[:name]), method: :post, class: "flex items-center gap-1.5 px-3.5 py-2 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs rounded-xl shadow-xs transition cursor-pointer" do %>
            Acknowledge Problem
          <% end %>
        <% elsif @host[:acknowledged] %>
          <%= button_to remove_acknowledgment_host_path(@host[:name]), method: :post, class: "flex items-center gap-1.5 px-3.5 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium text-xs rounded-xl border border-slate-200 dark:border-slate-700 transition cursor-pointer", title: "Cabut acknowledgement agar alert kembali aktif (Disack)" do %>
            Cabut ACK (Disack)
          <% end %>
        <% end %>

        <%= button_to schedule_cluster_downtime_host_path(@host[:name], duration_hours: 2), method: :post, class: "flex items-center gap-1.5 px-3.5 py-2 bg-indigo-50 dark:bg-indigo-950/60 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 text-indigo-700 dark:text-indigo-300 font-semibold text-xs rounded-xl border border-indigo-200 dark:border-indigo-800 transition cursor-pointer", title: "Jadwalkan downtime serentak untuk host dan seluruh services" do %>
          + Downtime Host & Services
        <% end %>

        <%= button_to recheck_all_services_host_path(@host[:name]), method: :post, class: "flex items-center gap-1.5 px-3.5 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold text-xs rounded-xl border border-slate-200/80 dark:border-slate-700 transition cursor-pointer", title: "Paksa re-check serentak seluruh service pada host ini" do %>
          ⚡ Re-check Semua Services
        <% end %>

        <%= button_to recheck_host_path(@host[:name]), method: :post, class: "flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-700 hover:to-indigo-600 text-white font-semibold text-xs rounded-xl shadow-md shadow-indigo-600/20 transition cursor-pointer" do %>
          Force Re-check Host
        <% end %>
      </div>
    </div>
  </div>

  <!-- Host Overview Card -->
  <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs p-6 grid grid-cols-1 md:grid-cols-4 gap-6 card-hover relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-1 <%= @host[:status] == 'UP' ? 'bg-gradient-to-r from-emerald-500 to-teal-400' : 'bg-gradient-to-r from-rose-600 to-rose-400' %>"></div>
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Jaringan & Alamat IP</p>
      <p class="text-base font-extrabold text-slate-900 dark:text-white mt-1.5 font-mono"><%= @host[:address] %></p>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 truncate" title="<%= @host[:alias] %>"><%= @host[:alias] %></p>
      <% if @host[:parents].present? && @host[:parents] != '-' %>
        <p class="text-[11px] text-indigo-600 dark:text-indigo-400 mt-1 font-mono">
          Parent: <%= link_to @host[:parents], host_path(@host[:parents]), class: "hover:underline font-semibold" %>
        </p>
      <% end %>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Plugin Output</p>
      <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 mt-1.5 font-mono text-xs bg-slate-50/70 dark:bg-slate-900/60 p-2.5 rounded-xl border border-slate-200/60 dark:border-slate-800/60 truncate" title="<%= @host[:plugin_output] %>"><%= @host[:plugin_output].presence || "-" %></p>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Terakhir Dicek</p>
      <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 mt-1.5 font-mono"><%= @host[:last_check] ? @host[:last_check].strftime("%H:%M:%S (%d %b %Y)") : "-" %></p>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 font-mono">Interval check: <%= @host[:check_interval] || 10 %>s</p>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Check Attempt</p>
      <p class="text-sm font-extrabold text-slate-800 dark:text-slate-200 mt-1.5 font-mono text-base"><%= @host[:current_attempt] || 1 %> / <%= @host[:max_attempts] || 3 %></p>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">State type: <%= @host[:state_type] || 'HARD' %></p>
    </div>
  </div>

  <!-- Operational Commands Panel (cmd.cgi) -->
  <%= render "hosts/operational_controls", host: @host %>

  <!-- Realtime Performance Graph Chart.js Card -->
  <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs p-6 space-y-4 card-hover">
    <div class="flex justify-between items-center border-b border-slate-200/60 dark:border-slate-800/60 pb-3">
      <div>
        <h3 class="font-bold text-slate-800 dark:text-slate-200 text-base">Performance Metrics & Latency Trend</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Grafik perbandingan latensi PING dan histori eksekusi check</p>
      </div>
      <span class="px-3 py-1 bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 text-xs font-bold rounded-lg border border-indigo-500/20 font-mono">Chart.js Live</span>
    </div>

    <div class="h-64 w-full pt-2">
      <canvas id="perfChart"></canvas>
    </div>
  </div>

  <!-- Monitored Services List -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-slate-800 dark:text-slate-200">Layanan Monitored (<%= @services.size %>)</h2>
      <span class="text-xs text-slate-400 dark:text-slate-500 font-mono"><%= @services.count { |s| s[:status] == 'OK' } %> OK / <%= @services.size %> Total</span>
    </div>

    <div class="bg-white dark:bg-[#111827] rounded-2xl shadow-xs border border-slate-200/80 dark:border-slate-800/80 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-200/80 dark:border-slate-800/80 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            <th class="py-4 px-6">Service Description</th>
            <th class="py-4 px-6">Status</th>
            <th class="py-4 px-6">Plugin Output</th>
            <th class="py-4 px-6">Terakhir Dicek</th>
            <th class="py-4 px-6 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
          <% if @services.empty? %>
            <tr>
              <td colspan="5" class="py-8 px-6 text-center text-slate-400 dark:text-slate-500">
                Tidak ada service terdaftar pada host ini.
              </td>
            </tr>
          <% else %>
            <% @services.each do |service| %>
              <%= render "hosts/service_row", service: service %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Active Downtimes Panel -->
  <%= render "hosts/downtimes_panel", downtimes: @downtimes %>

  <!-- Comments & Notes Panel -->
  <%= render "hosts/comments_panel", host: @host, services: @services, comments: @comments %>
</div>

<script>
  function initHostPerfChart() {
    var canvas = document.getElementById('perfChart');
    if (!canvas) return;
    if (window._hostPerfChart) {
      window._hostPerfChart.destroy();
    }
    var ctx = canvas.getContext('2d');
    window._hostPerfChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['09:00', '09:05', '09:10', '09:15', '09:20', '09:25', '09:30'],
        datasets: [{
          label: 'PING Latency (ms)',
          data: [0.08, 0.06, 0.05, 0.07, 0.06, 0.05, 0.06],
          borderColor: '#6366F1',
          backgroundColor: 'rgba(99, 102, 241, 0.1)',
          fill: true,
          tension: 0.4
        }, {
          label: 'Service Execution Time (s)',
          data: [0.01, 0.02, 0.01, 0.01, 0.03, 0.01, 0.01],
          borderColor: '#10B981',
          backgroundColor: 'rgba(16, 185, 129, 0.1)',
          fill: true,
          tension: 0.4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11 } } }
        },
        scales: {
          x: { grid: { display: false } },
          y: { beginAtZero: true, grid: { color: 'rgba(148, 163, 184, 0.1)' } }
        }
      }
    });
  }

  document.addEventListener("turbo:load", initHostPerfChart);
  document.addEventListener("DOMContentLoaded", initHostPerfChart);
</script>
