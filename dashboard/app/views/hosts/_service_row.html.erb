<% dom_id = "service_#{service[:host_name].parameterize}_#{service[:description].parameterize}" %>
<% perf_widget = render_perf_data_widget(service) %>

<tr id="<%= dom_id %>" data-filter-target="row" data-status="<%= service[:status] %>" class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
  <td class="py-4 px-6 text-sm text-slate-500 dark:text-slate-400 font-medium font-mono text-xs">
    <%= service[:host_name] %>
  </td>
  <td class="py-4 px-6 font-semibold text-slate-800 dark:text-slate-200">
    <div class="flex items-center gap-2">
      <span class="text-sm"><%= service[:description] %></span>
      <% if service[:acknowledged] %>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/20">
          ACK
        </span>
      <% end %>
      <% if service[:notifications_enabled] == false %>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20" title="Notifikasi dimatikan">
          🔕 Muted
        </span>
      <% end %>
      <% if service[:checks_enabled] == false %>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-500/10 text-slate-600 dark:text-slate-400 border border-slate-500/20" title="Active check dimatikan">
          ⏸️ Paused
        </span>
      <% end %>
      <% if service[:flapping] %>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-500/10 text-purple-700 dark:text-purple-400 border border-purple-500/20 animate-pulse" title="Service is flapping (sering berubah status)">
          🔀 Flapping<%= " (#{service[:percent_state_change].to_f.round(1)}%)" if service[:percent_state_change].to_f.positive? %>
        </span>
      <% end %>
      <% if service[:stale] %>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20" title="Hasil check service sudah usang / terlambat dieksekusi">
          ⏱️ Stale
        </span>
      <% end %>
    </div>
  </td>
  <td class="py-4 px-6">
    <div class="space-y-1">
      <% case service[:status] %>
      <% when 'OK' %>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> OK
        </span>
      <% when 'WARNING' %>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> WARNING
        </span>
      <% when 'CRITICAL' %>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> CRITICAL
        </span>
      <% else %>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-500/10 text-slate-700 dark:text-slate-400 border border-slate-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> <%= service[:status] %>
        </span>
      <% end %>

      <!-- Context Help Tooltip for HARD vs SOFT State -->
      <div class="relative group/tooltip inline-block">
        <p class="text-[11px] text-slate-400 dark:text-slate-500 font-mono cursor-help border-b border-dotted border-slate-300 dark:border-slate-600 inline-block">
          Attempt <%= service[:attempts] %> (<%= service[:state_type] %>)
        </p>
        <div class="absolute left-0 bottom-full mb-1.5 hidden group-hover/tooltip:block z-20 w-56 p-2.5 bg-slate-900/95 backdrop-blur-md text-white text-[11px] rounded-xl shadow-xl border border-slate-700">
          <% if service[:state_type] == 'HARD' %>
            <strong class="text-amber-300">HARD State:</strong> Status telah terkonfirmasi setelah batas percobaan maksimal. Notifikasi telah/dapat dikirimkan ke kontak.
          <% else %>
            <strong class="text-sky-300">SOFT State:</strong> Status sementara dalam proses retry check. Belum ada notifikasi yang dipicu.
          <% end %>
        </div>
      </div>
    </div>
  </td>
  <td class="py-4 px-6 text-sm text-slate-600 dark:text-slate-300 max-w-md">
    <div class="space-y-1">
      <p class="truncate font-mono text-xs"><%= service[:plugin_output].presence || "-" %></p>
      <% if perf_widget %>
        <div class="pt-0.5"><%= perf_widget %></div>
      <% end %>
    </div>
  </td>
  <td class="py-4 px-6 text-xs text-slate-500 dark:text-slate-400 font-mono">
    <p><%= service[:last_check] ? service[:last_check].strftime("%H:%M:%S (%d %b)") : "-" %></p>
    <% if service[:next_check] %>
      <p class="text-[10px] text-slate-400 dark:text-slate-500">Next: <%= service[:next_check].strftime("%H:%M:%S") %></p>
    <% end %>
  </td>
  <td class="py-4 px-6 text-right">
    <div class="flex items-center justify-end gap-1.5">
      <% if %w[WARNING CRITICAL UNKNOWN].include?(service[:status]) && !service[:acknowledged] %>
        <%= button_to acknowledge_service_host_path(service[:host_name], service_desc: service[:description]),
                      method: :post,
                      class: "text-xs px-2.5 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-800 dark:text-amber-300 font-semibold border border-amber-500/30 rounded-lg transition cursor-pointer" do %>
          Acknowledge
        <% end %>
      <% elsif service[:acknowledged] %>
        <%= button_to remove_service_acknowledgment_host_path(service[:host_name], service_desc: service[:description]),
                      method: :post,
                      title: "Cabut acknowledgement agar alert kembali aktif (Disack)",
                      class: "text-xs px-2.5 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium border border-slate-200 dark:border-slate-700 rounded-lg transition cursor-pointer" do %>
          Disack
        <% end %>
      <% end %>

      <%= button_to schedule_service_downtime_host_path(service[:host_name], service_desc: service[:description], duration_hours: 1),
                    method: :post,
                    class: "text-xs px-2.5 py-1.5 bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-700 dark:text-indigo-300 font-medium border border-indigo-500/30 rounded-lg transition cursor-pointer" do %>
        + Downtime
      <% end %>

      <% if service[:notifications_enabled] == false %>
        <%= button_to toggle_service_notifications_host_path(service[:host_name], service_desc: service[:description], enable: 'true'),
                      method: :post,
                      title: "Aktifkan notifikasi untuk service ini",
                      class: "text-xs px-2 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-700 dark:text-amber-300 font-medium rounded-lg border border-amber-500/30 transition cursor-pointer" do %>
          🔔 Unmute
        <% end %>
      <% else %>
        <%= button_to toggle_service_notifications_host_path(service[:host_name], service_desc: service[:description], enable: 'false'),
                      method: :post,
                      title: "Mute notifikasi untuk service ini",
                      class: "text-xs px-2 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 font-medium rounded-lg border border-slate-200 dark:border-slate-700 transition cursor-pointer" do %>
          🔕 Mute
        <% end %>
      <% end %>

      <%= button_to recheck_service_host_path(service[:host_name], service_desc: service[:description]),
                    method: :post,
                    class: "text-xs px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium rounded-lg border border-slate-200/80 dark:border-slate-700 transition cursor-pointer" do %>
        Re-check
      <% end %>
    </div>
  </td>
</tr>
