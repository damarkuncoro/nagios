<!-- Operational Commands Panel (Adopsi dari cmd.cgi) -->
<div class="glass-panel rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs p-6 space-y-4 card-hover">
  <div class="flex items-center justify-between border-b border-slate-200/60 dark:border-slate-800/60 pb-3">
    <div>
      <h3 class="font-bold text-slate-800 dark:text-slate-200 text-base flex items-center gap-2">
        <span>Kontrol Operasional Engine</span>
        <span class="text-xs px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 font-mono border border-indigo-500/20">cmd.cgi</span>
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Kelola eksekusi check, notifikasi, atau kirim hasil passive check secara instan</p>
    </div>
  </div>

  <% can_execute = defined?(current_user_profile) && current_user_profile ? current_user_profile.can_execute_commands? : true %>

  <% if !can_execute %>
    <div class="p-4 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-800 dark:text-amber-200 text-xs flex items-center gap-2.5">
      <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      <span>Mode Read-Only: Profil kontak Anda tidak memiliki izin untuk mengeksekusi perintah operasional sistem (<span class="font-mono">cmd.cgi</span>).</span>
    </div>
  <% else %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 pt-1">
      <!-- Quick Toggles -->
      <div class="p-5 bg-slate-50/70 dark:bg-slate-900/60 rounded-xl border border-slate-200/70 dark:border-slate-800/70 space-y-3">
        <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Host Operational Switches</p>
        <div class="flex flex-wrap gap-2.5">
          <% if host[:notifications_enabled] == false %>
            <%= button_to toggle_notifications_host_path(host[:name], enable: 'true'), method: :post, class: "text-xs px-3.5 py-2 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 font-semibold rounded-xl border border-emerald-500/30 transition cursor-pointer" do %>
              🔔 Enable Notifications
            <% end %>
          <% else %>
            <%= button_to toggle_notifications_host_path(host[:name], enable: 'false'), method: :post, class: "text-xs px-3.5 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium rounded-xl border border-slate-200/80 dark:border-slate-700 transition cursor-pointer" do %>
              🔕 Mute Notifications
            <% end %>
          <% end %>

          <% if host[:checks_enabled] == false %>
            <%= button_to toggle_checks_host_path(host[:name], enable: 'true'), method: :post, class: "text-xs px-3.5 py-2 bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-700 dark:text-indigo-300 font-semibold rounded-xl border border-indigo-500/30 transition cursor-pointer" do %>
              ▶️ Enable Active Checks
            <% end %>
          <% else %>
            <%= button_to toggle_checks_host_path(host[:name], enable: 'false'), method: :post, class: "text-xs px-3.5 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium rounded-xl border border-slate-200/80 dark:border-slate-700 transition cursor-pointer" do %>
              ⏸️ Pause Checks
            <% end %>
          <% end %>

          <% if host[:flap_detection_enabled] == false %>
            <%= button_to toggle_flap_detection_host_path(host[:name], enable: 'true'), method: :post, class: "text-xs px-3.5 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-700 dark:text-amber-300 font-semibold rounded-xl border border-amber-500/30 transition cursor-pointer" do %>
              🔀 Enable Flap Detection
            <% end %>
          <% else %>
            <%= button_to toggle_flap_detection_host_path(host[:name], enable: 'false'), method: :post, class: "text-xs px-3.5 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium rounded-xl border border-slate-200/80 dark:border-slate-700 transition cursor-pointer" do %>
              ⏹️ Disable Flap Detection
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Submit Passive Check Form -->
      <div class="p-5 bg-slate-50/70 dark:bg-slate-900/60 rounded-xl border border-slate-200/70 dark:border-slate-800/70 space-y-3">
        <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Submit Passive Check</p>
        <%= form_with url: submit_passive_check_host_path(host[:name]), method: :post, class: "space-y-2.5 text-xs" do |f| %>
          <div class="flex gap-2">
            <%= f.select :status_code, options_for_select([["0 - OK / UP", 0], ["1 - WARNING", 1], ["2 - CRITICAL / DOWN", 2], ["3 - UNKNOWN", 3]]), {}, class: "px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            <%= f.text_field :output, placeholder: "Custom check output message...", class: "flex-1 px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700 rounded-xl text-slate-800 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 font-mono" %>
          </div>
          <%= f.submit "Kirim Hasil Check ke Engine", class: "w-full py-2 px-3 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-semibold rounded-xl transition cursor-pointer shadow-sm" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
