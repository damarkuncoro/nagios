<tr id="host_<%= host[:name].parameterize %>" class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
  <td class="py-4 px-6 font-semibold text-slate-800 dark:text-slate-200">
    <div class="flex items-center gap-2 flex-wrap">
      <%= link_to host[:name], host_path(host[:name]), class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 hover:underline transition font-mono" %>
      <% if host[:address].present? %>
        <span class="text-[11px] text-slate-400 dark:text-slate-500 font-mono font-normal">
          (<%= host[:address] %>)
        </span>
      <% end %>
      <% if host[:parents].present? && host[:parents] != '-' %>
        <span class="text-[10px] px-2 py-0.5 rounded-md bg-indigo-500/10 text-indigo-400 font-mono font-normal" title="Uplink Parent Node">
          ↳ <%= host[:parents] %>
        </span>
      <% end %>
      <% if host[:notifications_enabled] == false %>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20" title="Notifikasi host dimatikan">
          🔕 Muted
        </span>
      <% end %>
      <% if host[:checks_enabled] == false %>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-500/10 text-slate-600 dark:text-slate-400 border border-slate-500/20" title="Active check host dimatikan">
          ⏸️ Paused
        </span>
      <% end %>
      <% if host[:flapping] %>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-500/10 text-purple-700 dark:text-purple-400 border border-purple-500/20 animate-pulse" title="Host is flapping (sering berubah status)">
          🔀 Flapping<%= " (#{host[:percent_state_change].to_f.round(1)}%)" if host[:percent_state_change].to_f.positive? %>
        </span>
      <% end %>
      <% if host[:stale] %>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20" title="Hasil check host sudah usang / terlambat dieksekusi">
          ⏱️ Stale
        </span>
      <% end %>
    </div>
  </td>
  <td class="py-4 px-6">
    <% case host[:status] %>
    <% when 'UP' %>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> UP
      </span>
    <% when 'DOWN' %>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> DOWN
      </span>
    <% else %>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> <%= host[:status] %>
      </span>
    <% end %>
  </td>
  <td class="py-4 px-6 text-sm text-slate-600 dark:text-slate-300 max-w-xs truncate font-mono text-xs">
    <%= host[:plugin_output].presence || "-" %>
  </td>
  <td class="py-4 px-6 text-xs text-slate-500 dark:text-slate-400 font-mono">
    <%= host[:last_check] ? host[:last_check].strftime("%H:%M:%S (%d %b)") : "-" %>
  </td>
  <td class="py-4 px-6 text-right">
    <%= button_to recheck_host_path(host[:name]),
                  method: :post,
                  class: "text-xs px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium rounded-lg border border-slate-200/80 dark:border-slate-700 transition cursor-pointer" do %>
      Re-check
    <% end %>
  </td>
</tr>
