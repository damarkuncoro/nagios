<!-- Comments & Notes Section for this host -->
<div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-xs p-6 space-y-4">
  <div class="flex items-center justify-between">
    <div>
      <h3 class="font-bold text-slate-800 dark:text-slate-200 text-base flex items-center gap-2">
        <span>💬 Catatan Penanganan & Komentar</span>
        <span class="px-2 py-0.5 rounded-full text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-bold"><%= comments.size %></span>
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400">Log catatan insiden atau tindakan tim operasional untuk host ini</p>
    </div>
  </div>

  <!-- Inline Add Comment Form -->
  <%= form_with url: comments_path, method: :post, class: "flex flex-col sm:flex-row gap-2" do |f| %>
    <%= f.hidden_field :host_name, value: host[:name] %>
    <%= f.select :service_desc, [["(Komentar Host Ini)", ""]] + services.map { |s| [s[:description], s[:description]] }, {}, class: "p-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-xs text-slate-800 dark:text-slate-200 focus:outline-none" %>
    <%= f.text_field :comment, placeholder: "Tuliskan catatan insiden baru...", class: "flex-1 p-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 focus:outline-none" %>
    <%= f.submit "+ Tambah Catatan", class: "py-2 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs rounded-lg transition cursor-pointer shrink-0" %>
  <% end %>

  <% if comments.any? %>
    <div class="divide-y divide-slate-100 dark:divide-slate-800 pt-2">
      <% comments.each do |c| %>
        <div class="py-2.5 flex justify-between items-center text-xs">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-800 dark:text-slate-200"><%= c[:author] %></span>
              <% if c[:service_description].present? %>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400"><%= c[:service_description] %></span>
              <% else %>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 font-semibold">HOST</span>
              <% end %>
              <span class="text-[11px] text-slate-400 font-mono"><%= c[:entry_time].strftime("%H:%M:%S (%d %b)") %></span>
            </div>
            <p class="text-slate-700 dark:text-slate-300 mt-1">"<%= c[:comment] %>"</p>
          </div>
          <%= button_to comment_path(c[:id]), method: :delete, data: { turbo_confirm: "Hapus catatan ini?" }, class: "text-rose-600 dark:text-rose-400 hover:text-rose-800 text-xs px-2 py-1 rounded cursor-pointer" do %>
            Hapus
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
