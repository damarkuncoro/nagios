<div class="max-w-7xl mx-auto space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Hostgroups</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20">
          Infrastructure Clustering
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Pengelompokan server berdasarkan kategori infrastruktur (<span class="font-mono text-xs">status.cgi?hostgroup=all</span>)</p>
    </div>
  </div>

  <% if @hostgroups.empty? %>
    <div class="glass-panel p-12 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 text-center text-slate-400 dark:text-slate-500">
      <svg class="w-10 h-10 mx-auto text-slate-300 dark:text-slate-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
      <p class="font-semibold text-base">Tidak ada Hostgroup terdaftar di Nagios Core.</p>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Konfigurasikan hostgroup di nagios.cfg atau conf.d untuk mengelompokkan host.</p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% @hostgroups.each do |group| %>
        <div class="glass-panel rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
          <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-200/80 dark:border-slate-800/80 flex justify-between items-center">
            <div>
              <h3 class="font-bold text-slate-800 dark:text-slate-100 text-base flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                <%= group[:alias].presence || group[:name] %>
              </h3>
              <% if group[:alias].present? && group[:alias] != group[:name] %>
                <p class="text-xs font-mono text-slate-400 dark:text-slate-500 mt-0.5"><%= group[:name] %></p>
              <% end %>
            </div>
            <span class="px-3 py-1 bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 text-xs font-semibold rounded-full border border-indigo-500/20 font-mono">
              <%= group[:hosts].size %> Hosts
            </span>
          </div>

          <div class="p-6 divide-y divide-slate-100 dark:divide-slate-800/60">
            <% group[:hosts].each do |host| %>
              <% h_hash = host.is_a?(Hash) ? host : host.to_h %>
              <div class="py-3.5 first:pt-0 last:pb-0 flex justify-between items-center gap-4">
                <div class="min-w-0">
                  <p class="font-semibold text-slate-800 dark:text-slate-200 text-sm truncate">
                    <%= link_to h_hash[:name], host_path(h_hash[:name]), class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 hover:underline transition" %>
                  </p>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-mono truncate"><%= h_hash[:plugin_output] %></p>
                </div>
                <span class="shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold <%= h_hash[:status] == 'UP' ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20' %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= h_hash[:status] == 'UP' ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
                  <%= h_hash[:status] %>
                </span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
