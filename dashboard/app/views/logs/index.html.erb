<div class="max-w-6xl mx-auto space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Live Event Log</h1>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-800">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> nagios.log stream
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Audit log real-time daemon Nagios Core, alert state changes, dan perintah eksternal (*showlog.cgi*)</p>
    </div>

    <!-- Filter Buttons & Refresh -->
    <div class="flex items-center gap-3">
      <%= link_to logs_path(type: @filter_type), class: "flex items-center gap-2 px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs rounded-lg shadow-xs transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        Refresh
      <% end %>
    </div>
  </div>

  <!-- Filter Pills Bar -->
  <div class="flex flex-wrap items-center gap-2">
    <% ['ALL', 'ALERT', 'NOTIFICATION', 'COMMAND', 'SYSTEM'].each do |f_type| %>
      <%= link_to logs_path(type: f_type), class: "px-3.5 py-1.5 rounded-lg text-xs font-semibold border transition #{ @filter_type == f_type ? 'bg-indigo-600 text-white border-indigo-600 shadow-xs' : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800' }" do %>
        <%= f_type %>
      <% end %>
    <% end %>
  </div>

  <!-- Terminal Log Card -->
  <div class="bg-slate-950 text-slate-200 rounded-xl shadow-lg border border-slate-800 overflow-hidden font-mono text-xs">
    <div class="px-5 py-3 bg-slate-900 border-b border-slate-800 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-rose-500 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
        <span class="ml-2 text-slate-400 text-[11px]">/var/log/nagios.log (Last <%= @logs.size %> events)</span>
      </div>
      <span class="text-slate-500 text-[10px]">Filter: <%= @filter_type %></span>
    </div>

    <div class="p-4 max-h-[600px] overflow-y-auto space-y-2 divide-y divide-slate-900">
      <% if @logs.empty? %>
        <p class="py-8 text-center text-slate-500">Tidak ada log yang ditemukan untuk filter ini.</p>
      <% else %>
        <% @logs.each do |log| %>
          <div class="pt-2 flex flex-col sm:flex-row sm:items-start gap-2 hover:bg-slate-900/60 p-1.5 rounded transition">
            <!-- Timestamp -->
            <span class="text-slate-500 shrink-0 select-none text-[11px] font-medium">
              <%= log[:timestamp]&.strftime("%Y-%m-%d %H:%M:%S") %>
            </span>

            <!-- Category Badge -->
            <span class="shrink-0 px-2 py-0.5 rounded text-[10px] font-bold text-center w-28 <%=
              case log[:category]
              when 'ALERT' then 'bg-rose-950 text-rose-300 border border-rose-800'
              when 'NOTIFICATION' then 'bg-sky-950 text-sky-300 border border-sky-800'
              when 'COMMAND' then 'bg-amber-950 text-amber-300 border border-amber-800'
              else 'bg-slate-800 text-slate-300 border border-slate-700'
              end
            %>">
              <%= log[:type] %>
            </span>

            <!-- Message details -->
            <span class="text-slate-300 break-all flex-1">
              <%= log[:message] %>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
