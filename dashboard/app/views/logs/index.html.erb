<div class="max-w-7xl mx-auto space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Live Event Log</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>nagios.log stream</span>
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Audit log real-time daemon Nagios Core, alert state changes, dan perintah eksternal (showlog.cgi)</p>
    </div>

    <!-- Filter Buttons & Refresh -->
    <div class="flex items-center gap-3">
      <%= link_to logs_path(type: @filter_type), class: "inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-700 hover:to-indigo-600 text-white font-semibold text-xs rounded-xl shadow-md shadow-indigo-600/20 transition cursor-pointer" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        <span>Refresh Logs</span>
      <% end %>
    </div>
  </div>

  <!-- Filter Pills Bar -->
  <div class="flex items-center gap-2 border-b border-slate-200/80 dark:border-slate-800/80 pb-3 overflow-x-auto">
    <% ['ALL', 'ALERT', 'NOTIFICATION', 'COMMAND', 'SYSTEM'].each do |f_type| %>
      <%= link_to logs_path(type: f_type), class: "px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition cursor-pointer #{ (@filter_type == f_type || (@filter_type.blank? && f_type == 'ALL')) ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/25' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-slate-800/60' }" do %>
        <%= f_type %>
      <% end %>
    <% end %>
  </div>

  <!-- Terminal Log Card -->
  <div class="bg-[#0B0F19] text-slate-200 rounded-2xl shadow-xl border border-slate-800 overflow-hidden font-mono text-xs card-hover">
    <div class="px-5 py-3.5 bg-slate-900/90 border-b border-slate-800/80 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="w-3 h-3 rounded-full bg-rose-500 inline-block shadow-sm"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500 inline-block shadow-sm"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block shadow-sm"></span>
        <span class="ml-2 text-slate-400 text-xs font-medium">/var/log/nagios.log (Last <%= @logs.size %> events)</span>
      </div>
      <span class="text-slate-400 text-xs font-semibold px-2.5 py-0.5 rounded-md bg-slate-800 border border-slate-700">Filter: <%= @filter_type %></span>
    </div>

    <div class="p-5 max-h-[600px] overflow-y-auto space-y-2 divide-y divide-slate-800/40">
      <% if @logs.empty? %>
        <p class="py-10 text-center text-slate-500">Tidak ada log yang ditemukan untuk filter ini.</p>
      <% else %>
        <% @logs.each do |log| %>
          <div class="pt-2.5 flex flex-col sm:flex-row sm:items-start gap-3 hover:bg-slate-900/60 p-2 rounded-xl transition">
            <!-- Timestamp -->
            <span class="text-slate-500 shrink-0 select-none text-[11px] font-medium pt-0.5">
              <%= log[:timestamp]&.strftime("%Y-%m-%d %H:%M:%S") %>
            </span>

            <!-- Category Badge -->
            <span class="shrink-0 px-2.5 py-0.5 rounded-lg text-[10px] font-bold text-center w-28 <%=
              case log[:category]
              when 'ALERT' then 'bg-rose-500/10 text-rose-400 border border-rose-500/30'
              when 'NOTIFICATION' then 'bg-sky-500/10 text-sky-400 border border-sky-500/30'
              when 'COMMAND' then 'bg-amber-500/10 text-amber-400 border border-amber-500/30'
              else 'bg-slate-800 text-slate-300 border border-slate-700'
              end
            %>">
              <%= log[:type] %>
            </span>

            <!-- Message details -->
            <span class="text-slate-300 break-all flex-1 text-xs leading-relaxed">
              <%= log[:message] %>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
