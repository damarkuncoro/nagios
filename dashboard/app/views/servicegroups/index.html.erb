<div class="max-w-7xl mx-auto space-y-8" data-controller="auto-refresh" data-auto-refresh-interval-value="15000">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Service Groups Overview</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20">
          Service Grouping
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Pengelompokan ketersediaan service berdasarkan jenis fungsi infrastruktur (<span class="font-mono text-xs">status.cgi?servicegroup=all</span>)</p>
    </div>

    <%= link_to servicegroups_path, class: "flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:from-indigo-700 active:to-violet-700 text-white font-medium text-xs rounded-xl shadow-xs transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
      Refresh
    <% end %>
  </div>

  <% if @servicegroups.empty? %>
    <div class="glass-panel p-12 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 text-center text-slate-400 dark:text-slate-500">
      <svg class="w-10 h-10 mx-auto text-slate-300 dark:text-slate-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>
      <p class="font-semibold text-base">Tidak ada Service Group terdaftar di Nagios Core.</p>
    </div>
  <% else %>
    <div class="space-y-6">
      <% @servicegroups.each do |sg| %>
        <div class="glass-panel rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
          <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-200/80 dark:border-slate-800/80 flex flex-wrap justify-between items-center gap-3">
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full <%= sg[:all_ok] ? 'bg-emerald-500' : 'bg-amber-500' %>"></span>
              <h3 class="font-bold text-slate-800 dark:text-slate-100 text-lg"><%= sg[:name] %></h3>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-bold font-mono border <%= sg[:all_ok] ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/20' : 'bg-amber-500/10 text-amber-700 dark:text-amber-400 border-amber-500/20' %>">
              <%= sg[:ok_count] %> / <%= sg[:total_count] %> Services OK
            </span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-slate-50/50 dark:bg-slate-800/30 border-b border-slate-200/80 dark:border-slate-800/80 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                  <th class="py-3 px-6">Host</th>
                  <th class="py-3 px-6">Service</th>
                  <th class="py-3 px-6">Status</th>
                  <th class="py-3 px-6">Plugin Output</th>
                  <th class="py-3 px-6 text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                <% sg[:services].each do |service| %>
                  <%= render "hosts/service_row", service: service %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
