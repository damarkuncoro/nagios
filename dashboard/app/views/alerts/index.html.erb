<div class="max-w-7xl mx-auto space-y-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Alert History</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
          <span>history.cgi engine</span>
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Riwayat transisi status host dan service</p>
    </div>

    <!-- Duration Filter Pills -->
    <div class="flex items-center gap-1.5 p-1 bg-slate-100 dark:bg-slate-800 rounded-xl text-xs font-semibold border border-slate-200/60 dark:border-slate-700/60">
      <%= link_to "24 Jam", alerts_path(duration: 86400), class: "px-3.5 py-1.5 rounded-lg transition #{(@duration.nil? || @duration == 86400) ? 'bg-white dark:bg-[#111827] text-indigo-600 dark:text-indigo-400 shadow-xs font-bold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}" %>
      <%= link_to "7 Hari", alerts_path(duration: 604800), class: "px-3.5 py-1.5 rounded-lg transition #{@duration == 604800 ? 'bg-white dark:bg-[#111827] text-indigo-600 dark:text-indigo-400 shadow-xs font-bold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}" %>
      <%= link_to "30 Hari", alerts_path(duration: 2592000), class: "px-3.5 py-1.5 rounded-lg transition #{@duration == 2592000 ? 'bg-white dark:bg-[#111827] text-indigo-600 dark:text-indigo-400 shadow-xs font-bold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}" %>
    </div>
  </div>

  <div class="bg-white dark:bg-[#111827] rounded-2xl shadow-xs border border-slate-200/80 dark:border-slate-800/80 overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-200/80 dark:border-slate-800/80 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
          <th class="py-4 px-6">Waktu</th>
          <th class="py-4 px-6">Host</th>
          <th class="py-4 px-6">Service</th>
          <th class="py-4 px-6">State</th>
          <th class="py-4 px-6">Plugin Output</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
        <% if @alerts.empty? %>
          <tr>
            <td colspan="5" class="py-12 px-6 text-center text-slate-400 dark:text-slate-500">
              <svg class="w-12 h-12 mx-auto text-slate-300 dark:text-slate-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <p class="font-semibold text-slate-600 dark:text-slate-300">Tidak ada Alert Log dalam rentang waktu yang dipilih.</p>
              <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Sistem berjalan dengan stabil tanpa transisi status bermasalah.</p>
            </td>
          </tr>
        <% else %>
          <% @alerts.each do |alert| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
              <td class="py-4 px-6 text-sm text-slate-500 dark:text-slate-400 font-mono text-xs">
                <%= alert[:timestamp].strftime("%H:%M:%S (%d %b)") %>
              </td>
              <td class="py-4 px-6 text-sm font-semibold text-slate-800 dark:text-slate-200">
                <%= link_to alert[:host_name], host_path(alert[:host_name]), class: "hover:text-indigo-600 dark:hover:text-indigo-400 transition" %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-700 dark:text-slate-300 font-medium">
                <%= alert[:service_description].presence || "HOST" %>
              </td>
              <td class="py-4 px-6">
                <% case alert[:state].to_s.upcase %>
                <% when 'OK', 'UP' %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 font-mono">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> OK
                  </span>
                <% when 'WARNING' %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20 font-mono">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> WARNING
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-700 dark:text-rose-300 border border-rose-500/20 font-mono">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> <%= alert[:state] %>
                  </span>
                <% end %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-600 dark:text-slate-300 max-w-xs truncate font-mono text-xs">
                <%= alert[:plugin_output] %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
