<div class="max-w-6xl mx-auto space-y-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Alert History</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Riwayat transisi status host dan service (*history.cgi*)</p>
    </div>

    <!-- Duration Filter Pills -->
    <div class="flex items-center gap-1.5 p-1 bg-slate-100 dark:bg-slate-800 rounded-lg text-xs font-semibold">
      <%= link_to "24 Jam", alerts_path(duration: 86400), class: "px-3 py-1.5 rounded-md transition #{@duration == 86400 ? 'bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}" %>
      <%= link_to "7 Hari", alerts_path(duration: 604800), class: "px-3 py-1.5 rounded-md transition #{@duration == 604800 ? 'bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}" %>
      <%= link_to "30 Hari", alerts_path(duration: 2592000), class: "px-3 py-1.5 rounded-md transition #{@duration == 2592000 ? 'bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}" %>
    </div>
  </div>

  <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
          <th class="py-3.5 px-6">Waktu</th>
          <th class="py-3.5 px-6">Host</th>
          <th class="py-3.5 px-6">Service</th>
          <th class="py-3.5 px-6">State</th>
          <th class="py-3.5 px-6">Plugin Output</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <% if @alerts.empty? %>
          <tr>
            <td colspan="5" class="py-12 px-6 text-center text-slate-400 dark:text-slate-500">
              <svg class="w-12 h-12 mx-auto text-slate-300 dark:text-slate-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <p class="font-semibold text-slate-600 dark:text-slate-300">Tidak ada Alert Log dalam 24 jam terakhir.</p>
              <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Sistem berjalan dengan stabil tanpa insiden kritis.</p>
            </td>
          </tr>
        <% else %>
          <% @alerts.each do |alert| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
              <td class="py-4 px-6 text-sm text-slate-500 dark:text-slate-400 font-mono text-xs">
                <%= alert[:timestamp].strftime("%H:%M:%S (%d %b)") %>
              </td>
              <td class="py-4 px-6 text-sm font-semibold text-slate-800 dark:text-slate-200">
                <%= link_to alert[:host_name], host_path(alert[:host_name]), class: "hover:text-indigo-600 dark:hover:text-indigo-400 hover:underline" %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-700 dark:text-slate-300 font-medium">
                <%= alert[:service_description].presence || "HOST" %>
              </td>
              <td class="py-4 px-6">
                <% case alert[:state].to_s.upcase %>
                <% when 'OK', 'UP' %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">OK</span>
                <% when 'WARNING' %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">WARNING</span>
                <% else %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300"><%= alert[:state] %></span>
                <% end %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-600 dark:text-slate-300 max-w-xs truncate font-mono text-xs">
                <%= alert[:plugin_output] %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
