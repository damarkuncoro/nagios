<div class="max-w-7xl mx-auto space-y-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Nagios Core Process Info</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
          <span>Daemon Core Status</span>
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Status internal daemon, kontrol fitur, dan tes notifikasi Nagios Engine</p>
    </div>
  </div>

  <% if notice.present? %>
    <div class="p-4 bg-emerald-500/10 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300 rounded-xl text-sm font-medium">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="p-4 bg-rose-500/10 border border-rose-500/20 text-rose-800 dark:text-rose-300 rounded-xl text-sm font-medium">
      <%= alert %>
    </div>
  <% end %>

  <% if @program_status %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 <%= @program_status[:version].to_s.include?('Ruby') ? 'bg-gradient-to-r from-violet-500 to-fuchsia-500' : 'bg-gradient-to-r from-indigo-500 to-violet-500' %>"></div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Engine Version</p>
        <p class="text-3xl font-extrabold <%= @program_status[:version].to_s.include?('Ruby') ? 'text-violet-600 dark:text-violet-400' : 'text-indigo-600 dark:text-indigo-400' %> mt-2 font-mono">v<%= @program_status[:version] %></p>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-2 font-medium"><%= @program_status[:version].to_s.include?('Ruby') ? '💎 Pure-Ruby Monitoring Engine' : 'Nagios Core C Engine' %></p>
      </div>

      <div class="p-6 bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-400"></div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Process PID</p>
        <p class="text-3xl font-extrabold text-slate-900 dark:text-white mt-2 font-mono">PID <%= @program_status[:pid] %></p>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-2 font-medium"><%= @program_status[:version].to_s.include?('Ruby') ? 'Ruby Daemon Subsystem' : 'Running in Docker Container' %></p>
      </div>

      <div class="p-6 bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 to-orange-400"></div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Start Time</p>
        <p class="text-2xl font-extrabold text-slate-800 dark:text-slate-100 mt-2 font-mono"><%= @program_status[:program_start]&.strftime("%H:%M:%S") %></p>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-2 font-medium"><%= @program_status[:program_start]&.strftime("%d %b %Y") %></p>
      </div>
    </div>

    <!-- Feature Matrix & Commands Panel -->
    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden">
      <div class="px-6 py-4.5 bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-200/80 dark:border-slate-800/80">
        <h3 class="font-bold text-slate-800 dark:text-white text-base">Engine Features & Control Panel</h3>
      </div>

      <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="p-5 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-slate-200 dark:border-slate-700/60 flex justify-between items-center">
          <div>
            <p class="font-bold text-slate-800 dark:text-white text-base">Notifications System</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Pengiriman alert via Email / Webhook</p>
          </div>
          <%= button_to toggle_process_info_feature_path(feature: "notifications", enable: !@program_status[:notifications_enabled]),
                        method: :post,
                        class: "px-3.5 py-1.5 rounded-lg text-xs font-bold transition cursor-pointer #{@program_status[:notifications_enabled] ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-700' : 'bg-slate-200 text-slate-700 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-300'}" do %>
            <%= @program_status[:notifications_enabled] ? 'ENABLED' : 'DISABLED' %>
          <% end %>
        </div>

        <div class="p-5 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-slate-200 dark:border-slate-700/60 flex justify-between items-center">
          <div>
            <p class="font-bold text-slate-800 dark:text-white text-base">Active Service Checks</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Penjadwalan eksekusi check otomatis</p>
          </div>
          <%= button_to toggle_process_info_feature_path(feature: "service_checks", enable: !@program_status[:service_checks_enabled]),
                        method: :post,
                        class: "px-3.5 py-1.5 rounded-lg text-xs font-bold transition cursor-pointer #{@program_status[:service_checks_enabled] ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-700' : 'bg-slate-200 text-slate-700 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-300'}" do %>
            <%= @program_status[:service_checks_enabled] ? 'ENABLED' : 'DISABLED' %>
          <% end %>
        </div>

        <div class="p-5 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-slate-200 dark:border-slate-700/60 flex justify-between items-center">
          <div>
            <p class="font-bold text-slate-800 dark:text-white text-base">Flap Detection Engine</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Deteksi fluktuasi status berulang</p>
          </div>
          <%= button_to toggle_process_info_feature_path(feature: "flap_detection", enable: !@program_status[:flap_detection_enabled]),
                        method: :post,
                        class: "px-3.5 py-1.5 rounded-lg text-xs font-bold transition cursor-pointer #{@program_status[:flap_detection_enabled] ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-700' : 'bg-slate-200 text-slate-700 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-300'}" do %>
            <%= @program_status[:flap_detection_enabled] ? 'ENABLED' : 'DISABLED' %>
          <% end %>
        </div>

        <div class="p-5 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-slate-200 dark:border-slate-700/60 flex justify-between items-center">
          <div>
            <p class="font-bold text-slate-800 dark:text-white text-base">Event Handlers</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Eksekusi skrip pemulihan otomatis</p>
          </div>
          <%= button_to toggle_process_info_feature_path(feature: "event_handlers", enable: !@program_status[:event_handlers_enabled]),
                        method: :post,
                        class: "px-3.5 py-1.5 rounded-lg text-xs font-bold transition cursor-pointer #{@program_status[:event_handlers_enabled] ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-700' : 'bg-slate-200 text-slate-700 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-300'}" do %>
            <%= @program_status[:event_handlers_enabled] ? 'ENABLED' : 'DISABLED' %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Modern Ruby Daemon Lifecycle Coordinator (base/nagios.c & base/events.c) -->
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 p-6 space-y-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <div class="flex items-center gap-2">
            <h3 class="font-bold text-slate-900 dark:text-white text-lg">⚙️ Ruby Daemon Lifecycle Coordinator</h3>
            <span class="text-xs px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 font-mono">base/nagios.c</span>
          </div>
          <p class="text-slate-500 dark:text-slate-400 text-xs mt-0.5">Pengendali siklus hidup proses, event queue loops, dan worker process pool</p>
        </div>

        <div class="flex items-center gap-2">
          <% case @daemon_status.state %>
          <% when :running %>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700 animate-pulse">
              ● RUNNING
            </span>
            <%= button_to toggle_daemon_path(daemon_action: 'pause'), method: :post, class: "px-3 py-1 bg-amber-500 hover:bg-amber-600 text-white rounded-lg text-xs font-bold transition cursor-pointer" do %>
              Jeda
            <% end %>
            <%= button_to toggle_daemon_path(daemon_action: 'stop'), method: :post, class: "px-3 py-1 bg-rose-600 hover:bg-rose-700 text-white rounded-lg text-xs font-bold transition cursor-pointer" do %>
              Hentikan
            <% end %>
          <% when :paused %>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 border border-amber-300 dark:border-amber-700">
              ❚❚ PAUSED
            </span>
            <%= button_to toggle_daemon_path(daemon_action: 'resume'), method: :post, class: "px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition cursor-pointer" do %>
              Lanjutkan
            <% end %>
            <%= button_to toggle_daemon_path(daemon_action: 'stop'), method: :post, class: "px-3 py-1 bg-rose-600 hover:bg-rose-700 text-white rounded-lg text-xs font-bold transition cursor-pointer" do %>
              Hentikan
            <% end %>
          <% else %>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-400 border border-slate-300 dark:border-slate-700">
              ■ STOPPED
            </span>
            <%= button_to toggle_daemon_path(daemon_action: 'start'), method: :post, class: "px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold shadow-xs transition cursor-pointer" do %>
              Mulai Daemon
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700/60">
          <p class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Timed Event Queue</p>
          <p class="text-2xl font-black text-slate-800 dark:text-white mt-1"><%= @daemon_status.queued_events %></p>
          <p class="text-[10px] text-slate-400 mt-0.5">Antrean event terjadwal</p>
        </div>

        <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700/60">
          <p class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Active Workers</p>
          <p class="text-2xl font-black text-indigo-600 dark:text-indigo-400 mt-1"><%= @daemon_status.active_workers %></p>
          <p class="text-[10px] text-slate-400 mt-0.5">Slot eksekusi berjalan</p>
        </div>

        <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700/60">
          <p class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Uptime</p>
          <p class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1"><%= @daemon_status.uptime_seconds %>s</p>
          <p class="text-[10px] text-slate-400 mt-0.5">Durasi runtime daemon</p>
        </div>

        <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700/60">
          <p class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">IPC Query Handler</p>
          <p class="text-2xl font-black <%= @qh_ping ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-700 dark:text-slate-300' %> mt-1">
            <%= @qh_ping ? 'ACTIVE' : 'IDLE' %>
          </p>
          <p class="text-[10px] text-slate-400 mt-0.5">Socket @echo probe</p>
        </div>
      </div>
    </div>

    <!-- Live Event Broker (NEB Adaptation from base/broker.c & base/nerd.c) -->
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 p-6 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-bold text-slate-800 dark:text-white text-lg flex items-center gap-2">
            <span>⚡ Live Domain Event Broker & NERD Dispatcher</span>
            <span class="text-xs px-2 py-0.5 rounded bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 font-mono">base/broker.c & base/nerd.c</span>
          </h3>
          <p class="text-slate-500 dark:text-slate-400 text-xs mt-0.5">Event internal dan saluran siaran radio streaming reaktif</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 font-bold border border-emerald-200 dark:border-emerald-800">
          Broker Active
        </span>
      </div>

      <% if @recent_broker_events.any? %>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
          <% @recent_broker_events.each do |e| %>
            <div class="py-2.5 flex items-center justify-between text-xs">
              <div class="flex items-center gap-2.5">
                <span class="font-mono font-bold uppercase px-2 py-0.5 rounded text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                  <%= e[:type] %>
                </span>
                <span class="text-slate-800 dark:text-slate-200 font-medium">
                  <%= e[:payload][:host_name] || e[:payload][:host] || e[:payload][:target] %>
                  <% if e[:payload][:service_desc] || e[:payload][:service] %>
                    • <%= e[:payload][:service_desc] || e[:payload][:service] %>
                  <% end %>
                </span>
                <span class="text-[10px] text-slate-400">via <%= e[:source] %></span>
              </div>
              <span class="font-mono text-slate-400 text-[11px]"><%= e[:timestamp].strftime("%H:%M:%S") %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-slate-400 dark:text-slate-500 italic py-2">Belum ada domain event baru. Lakukan aksi re-check, acknowledge, atau downtime untuk memicu event broker.</p>
      <% end %>
    </div>

    <!-- External Command Dispatcher Console (base/commands.c) -->
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 p-6 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-bold text-slate-800 dark:text-white text-lg flex items-center gap-2">
            <span>💻 External Command Dispatcher Console</span>
            <span class="text-xs px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/70 text-amber-700 dark:text-amber-300 font-mono">base/commands.c</span>
          </h3>
          <p class="text-slate-500 dark:text-slate-400 text-xs mt-0.5">Eksekusi instruksi external command Nagios (FIFO nagios.cmd format) secara real-time</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-mono">
          37 Command Opcodes
        </span>
      </div>

      <%= form_with url: execute_command_path, method: :post, class: "space-y-3" do |f| %>
        <div class="flex flex-col sm:flex-row gap-3">
          <%= f.text_field :command_string, id: "external_cmd_input", placeholder: "Contoh: PROCESS_SERVICE_CHECK_RESULT;localhost;PING;0;OK - Packet loss 0%|rta=0.12ms", value: "PROCESS_SERVICE_CHECK_RESULT;localhost;HTTP;0;OK - HTTP/1.1 200 OK - 0.042 second response time|time=0.042s;0.500;1.000", class: "flex-1 text-xs p-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 font-mono" %>
          <%= f.submit "Eksekusi Command", class: "py-3 px-5 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs rounded-lg transition cursor-pointer shrink-0" %>
        </div>
        <div class="flex flex-wrap gap-2 text-[11px] items-center text-slate-500 dark:text-slate-400">
          <span class="font-semibold text-slate-700 dark:text-slate-300">Preset:</span>
          <button type="button" onclick="document.getElementById('external_cmd_input').value='PROCESS_SERVICE_CHECK_RESULT;localhost;HTTP;0;OK - HTTP 200 OK|time=0.035s'" class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 font-mono cursor-pointer">Passive Svc OK</button>
          <button type="button" onclick="document.getElementById('external_cmd_input').value='PROCESS_SERVICE_CHECK_RESULT;localhost;HTTP;2;CRITICAL - Connection timed out|time=5.000s'" class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 font-mono cursor-pointer">Passive Svc CRIT</button>
          <button type="button" onclick="document.getElementById('external_cmd_input').value='ENABLE_NOTIFICATIONS'" class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 font-mono cursor-pointer">Enable Notifs</button>
          <button type="button" onclick="document.getElementById('external_cmd_input').value='DISABLE_NOTIFICATIONS'" class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 font-mono cursor-pointer">Disable Notifs</button>
          <button type="button" onclick="document.getElementById('external_cmd_input').value='SCHEDULE_FORCED_SVC_CHECK;localhost;PING;<%= Time.now.to_i %>'" class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 font-mono cursor-pointer">Schedule Check</button>
        </div>
      <% end %>
    </div>

    <!-- TCP Network Probe Tool (base/netutils.c) -->
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 p-6 space-y-4">
      <div>
        <h3 class="font-bold text-slate-800 dark:text-white text-lg flex items-center gap-2">
          <span>🌐 Network TCP Connection Probe</span>
          <span class="text-xs px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/70 text-blue-700 dark:text-blue-300 font-mono">base/netutils.c</span>
        </h3>
        <p class="text-slate-500 dark:text-slate-400 text-xs mt-0.5">Uji coba koneksi soket TCP non-blocking dan latensi respon port secara langsung</p>
      </div>

      <%= form_with url: test_tcp_probe_path, method: :post, class: "flex flex-col sm:flex-row gap-3" do |f| %>
        <%= f.text_field :host, placeholder: "Hostname / IP (cth. localhost / 127.0.0.1)", value: "127.0.0.1", class: "flex-1 text-xs p-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 font-mono" %>
        <%= f.number_field :port, placeholder: "Port (cth. 80, 443, 22)", value: 80, class: "w-32 text-xs p-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 font-mono" %>
        <%= f.submit "Jalankan TCP Probe", class: "py-3 px-5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg transition cursor-pointer shrink-0" %>
      <% end %>
    </div>

    <!-- Test Webhook Integration Card -->
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 p-6 space-y-4">
      <div>
        <h3 class="font-bold text-slate-800 dark:text-white text-lg">Test Multi-Channel Webhook Alerts</h3>
        <p class="text-slate-500 dark:text-slate-400 text-xs mt-0.5">Kirimkan notifikasi tes ke Slack, Discord, atau Telegram Incoming Webhook</p>
      </div>

      <%= form_with url: test_process_info_webhook_path, method: :post, class: "flex flex-col sm:flex-row gap-3" do |f| %>
        <%= f.text_field :webhook_url, placeholder: "https://hooks.slack.com/services/... atau Discord Webhook URL", class: "flex-1 text-xs p-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 focus:ring-2 focus:ring-indigo-500 focus:outline-none font-mono" %>
        <%= f.submit "Kirim Test Alert Notification", class: "py-3 px-5 bg-slate-900 hover:bg-slate-800 dark:bg-indigo-600 dark:hover:bg-indigo-500 text-white font-semibold text-xs rounded-lg transition cursor-pointer shrink-0" %>
      <% end %>
    </div>
  <% else %>
    <div class="p-8 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 text-center text-slate-400">
      Gagal mengambil status proses dari Nagios Core daemon.
    </div>
  <% end %>
</div>
