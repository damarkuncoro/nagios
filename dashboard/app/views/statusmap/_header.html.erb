<!-- Header -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Network Topology Map</h1>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
        <span class="font-mono">statusmap.cgi DAG Engine</span>
      </span>
    </div>
    <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Peta hubungan hierarki topologi jaringan, dependensi server, dan analisis jalur transmisi parent-child</p>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <!-- Blast Radius Simulation Toggle -->
    <button type="button"
            id="blastRadiusToggleBtn"
            onclick="toggleBlastRadiusMode()"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold border transition cursor-pointer bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 border-slate-300 dark:border-slate-700">
      <span>⚡</span>
      <span id="blastRadiusBtnText">Simulate Blast Radius</span>
    </button>

    <!-- Export Diagram Button -->
    <button type="button"
            onclick="exportTopologyDiagram()"
            class="inline-flex items-center gap-2 px-3.5 py-2 glass-panel hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-semibold transition cursor-pointer shadow-2xs">
      <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
      <span>Export Diagram</span>
    </button>

    <div class="flex items-center gap-2 px-3.5 py-2 bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border border-emerald-500/20 rounded-xl text-xs font-semibold">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Topology Live Sync</span>
    </div>

    <%= link_to statusmap_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-semibold text-xs rounded-xl shadow-md shadow-indigo-500/20 transition cursor-pointer" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
      <span>Refresh Map</span>
    <% end %>
  </div>
</div>

<!-- Blast Radius Simulation Active Banner -->
<div id="blastRadiusBanner" class="hidden p-4 rounded-2xl bg-amber-500/15 border border-amber-500/30 text-amber-800 dark:text-amber-200 text-xs font-semibold flex items-center justify-between">
  <div class="flex items-center gap-3">
    <span class="text-xl">⚠️</span>
    <div>
      <p class="font-bold text-sm">Mode Simulasi Blast Radius Aktif</p>
      <p class="text-[11px] text-amber-700 dark:text-amber-300 font-normal mt-0.5">Klik node server/gateway mana saja pada topologi untuk mensimulasikan kegagalan jaringan dan melihat dampaknya terhadap server turunan (*downstream impact*).</p>
    </div>
  </div>
  <button type="button" onclick="toggleBlastRadiusMode()" class="px-3 py-1.5 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition cursor-pointer font-bold">
    Keluar Mode Simulasi
  </button>
</div>
