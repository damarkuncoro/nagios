<style>
  @keyframes dash {
    to {
      stroke-dashoffset: -20;
    }
  }
</style>

<!-- Embedded Node Data for Client-Side Interactivity -->
<script>
  const topologyData = {
    root: <%= raw @map[:root].to_json %>,
    nodes: <%= raw @map[:nodes].to_json %>
  };

  let currentZoom = 1.0;
  let currentStatus = 'ALL';
  let currentTier = 'ALL';
  let isBlastRadiusMode = false;

  function toggleBlastRadiusMode() {
    isBlastRadiusMode = !isBlastRadiusMode;
    const banner = document.getElementById('blastRadiusBanner');
    const btn = document.getElementById('blastRadiusToggleBtn');
    const text = document.getElementById('blastRadiusBtnText');

    if (isBlastRadiusMode) {
      banner.classList.remove('hidden');
      btn.className = "inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold border transition cursor-pointer bg-amber-500 text-white border-amber-600 shadow-md shadow-amber-500/30";
      text.textContent = "Simulation Mode Active";
    } else {
      banner.classList.add('hidden');
      btn.className = "inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold border transition cursor-pointer bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 border-slate-300 dark:border-slate-700";
      text.textContent = "Simulate Blast Radius";
      resetSimulationVisuals();
    }
  }

  function handleNodeClick(nodeIndex) {
    if (isBlastRadiusMode) {
      simulateOutage(nodeIndex);
    } else {
      openNodeInspector(nodeIndex);
    }
  }

  function simulateOutage(failedIndex) {
    resetSimulationVisuals();

    if (failedIndex === 'root' || failedIndex === 'gateway') {
      const gatewayNode = document.getElementById('node_gateway');
      if (gatewayNode) {
        gatewayNode.classList.add('ring-4', 'ring-rose-500', 'animate-pulse');
      }

      topologyData.nodes.forEach((_, idx) => {
        const card = document.getElementById(`node_card_${idx}`);
        if (card) {
          card.classList.add('opacity-50', 'border-rose-500', 'bg-rose-950/40');
          const badge = card.querySelector('.node-status-badge');
          if (badge) {
            badge.textContent = "● UNREACHABLE";
            badge.className = "shrink-0 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30 font-mono node-status-badge animate-pulse";
          }
        }
      });
    } else {
      const card = document.getElementById(`node_card_${failedIndex}`);
      if (card) {
        card.classList.add('ring-4', 'ring-rose-500', 'animate-pulse');
        const badge = card.querySelector('.node-status-badge');
        if (badge) {
          badge.textContent = "● DOWN";
          badge.className = "shrink-0 px-2.5 py-1 rounded-full text-xs font-bold bg-rose-500 text-white font-mono node-status-badge";
        }
      }
    }
  }

  function resetSimulationVisuals() {
    const gatewayNode = document.getElementById('node_gateway');
    if (gatewayNode) {
      gatewayNode.classList.remove('ring-4', 'ring-rose-500', 'animate-pulse');
    }

    topologyData.nodes.forEach((node, idx) => {
      const card = document.getElementById(`node_card_${idx}`);
      if (card) {
        card.classList.remove('opacity-50', 'border-rose-500', 'bg-rose-950/40', 'ring-4', 'ring-rose-500', 'animate-pulse');
        const badge = card.querySelector('.node-status-badge');
        if (badge) {
          badge.textContent = `● ${node.status}`;
          badge.className = `shrink-0 px-2.5 py-1 rounded-full text-xs font-bold ${node.status === 'UP' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30' : 'bg-rose-500/10 text-rose-400 border border-rose-500/30'} font-mono node-status-badge`;
        }
      }
    });
  }

  function exportTopologyDiagram() {
    window.print();
  }

  function setLayoutMode(mode) {
    const treeBtn = document.getElementById('layoutTreeBtn');
    const radialBtn = document.getElementById('layoutRadialBtn');
    const treeContainer = document.getElementById('treeLayoutContainer');
    const radialContainer = document.getElementById('radialLayoutContainer');

    if (mode === 'tree') {
      treeBtn.className = "px-3 py-1 rounded-lg bg-white dark:bg-slate-700 text-slate-800 dark:text-white shadow-2xs transition flex items-center gap-1.5 cursor-pointer";
      radialBtn.className = "px-3 py-1 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white transition flex items-center gap-1.5 cursor-pointer";
      treeContainer.classList.remove('hidden');
      radialContainer.classList.add('hidden');
    } else {
      radialBtn.className = "px-3 py-1 rounded-lg bg-white dark:bg-slate-700 text-slate-800 dark:text-white shadow-2xs transition flex items-center gap-1.5 cursor-pointer";
      treeBtn.className = "px-3 py-1 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white transition flex items-center gap-1.5 cursor-pointer";
      radialContainer.classList.remove('hidden');
      treeContainer.classList.add('hidden');
    }
  }

  function adjustZoom(delta) {
    currentZoom = Math.min(Math.max(currentZoom + delta, 0.6), 1.5);
    applyZoom();
  }

  function resetZoom() {
    currentZoom = 1.0;
    applyZoom();
  }

  function applyZoom() {
    const canvas = document.getElementById('zoomableCanvas');
    if (canvas) {
      canvas.style.transform = `scale(${currentZoom})`;
    }
    const indicator = document.getElementById('zoomLevelIndicator');
    if (indicator) {
      indicator.textContent = `${Math.round(currentZoom * 100)}%`;
    }
  }

  function onSearchInput(query) {
    const clearBtn = document.getElementById('clearSearchBtn');
    if (clearBtn) {
      clearBtn.style.display = query ? 'block' : 'none';
    }
    applyFilters();
  }

  function clearSearchFilter() {
    const input = document.getElementById('topologySearchInput');
    if (input) {
      input.value = '';
    }
    const clearBtn = document.getElementById('clearSearchBtn');
    if (clearBtn) {
      clearBtn.style.display = 'none';
    }
    applyFilters();
  }

  function filterTier(tier) {
    currentTier = tier;
    applyFilters();
  }

  function filterStatus(status) {
    currentStatus = status;
    const allBtn = document.getElementById('filterBtnAll');
    const upBtn = document.getElementById('filterBtnUp');
    const downBtn = document.getElementById('filterBtnDown');
    const unreachableBtn = document.getElementById('filterBtnUnreachable');

    [allBtn, upBtn, downBtn, unreachableBtn].filter(Boolean).forEach(b => {
      b.className = "px-2.5 py-1 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white transition cursor-pointer flex items-center gap-1";
    });

    if (status === 'ALL') {
      allBtn.className = "px-2.5 py-1 rounded-lg bg-white dark:bg-slate-700 text-slate-800 dark:text-white shadow-2xs transition cursor-pointer flex items-center gap-1";
    } else if (status === 'UP') {
      upBtn.className = "px-2.5 py-1 rounded-lg bg-white dark:bg-slate-700 text-emerald-600 dark:text-emerald-400 shadow-2xs transition cursor-pointer flex items-center gap-1";
    } else if (status === 'DOWN') {
      downBtn.className = "px-2.5 py-1 rounded-lg bg-white dark:bg-slate-700 text-rose-600 dark:text-rose-400 shadow-2xs transition cursor-pointer flex items-center gap-1";
    } else if (status === 'UNREACHABLE' && unreachableBtn) {
      unreachableBtn.className = "px-2.5 py-1 rounded-lg bg-white dark:bg-slate-700 text-amber-600 dark:text-amber-400 shadow-2xs transition cursor-pointer flex items-center gap-1";
    }

    applyFilters();
  }

  function applyFilters() {
    const query = (document.getElementById('topologySearchInput')?.value || "").trim().toLowerCase();
    const cards = document.querySelectorAll('.topology-node-card');
    let visibleCount = 0;

    // Filter node cards
    cards.forEach(card => {
      const name = card.dataset.name || "";
      const cardStatus = card.dataset.status || "";
      const cardTier = card.dataset.tier || "";

      const matchQuery = !query || name.includes(query);
      const matchStatus = currentStatus === 'ALL' || cardStatus === currentStatus;
      const matchTier = currentTier === 'ALL' || cardTier === currentTier;

      if (matchQuery && matchStatus && matchTier) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Toggle Root Tier 0 visibility
    const rootNode = document.getElementById('node_root');
    if (rootNode) {
      const rootMatchTier = currentTier === 'ALL' || currentTier === '0';
      const rootMatchStatus = currentStatus === 'ALL' || currentStatus === 'UP';
      const rootMatchQuery = !query || 'master coordinator localhost'.includes(query);
      rootNode.style.display = (rootMatchTier && rootMatchStatus && rootMatchQuery) ? 'flex' : 'none';
    }

    // Toggle Tier Row containers visibility if no cards match in that tier
    document.querySelectorAll('.tier-row-container').forEach(row => {
      const rowTier = row.dataset.tierRow;
      const visibleInRow = row.querySelectorAll('.topology-node-card:not([style*="display: none"])').length;
      const tierAllowed = currentTier === 'ALL' || currentTier === rowTier;
      row.style.display = (visibleInRow > 0 && tierAllowed) ? 'block' : 'none';
    });

    const emptyMsg = document.getElementById('noMatchMessage');
    if (emptyMsg) {
      emptyMsg.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  function toggleTopologyFullscreen() {
    const container = document.getElementById('topologyCanvasContainer');
    if (!container) return;

    if (!document.fullscreenElement) {
      container.requestFullscreen().catch(err => {
        console.warn('Error attempting to enable fullscreen:', err.message);
      });
    } else {
      document.exitFullscreen();
    }
  }
</script>
