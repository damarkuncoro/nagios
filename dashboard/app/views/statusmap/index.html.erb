<div class="max-w-7xl mx-auto space-y-8" data-controller="auto-refresh" data-auto-refresh-interval-value="15000">
  <!-- Header & Simulation Banner -->
  <%= render "statusmap/header" %>

  <!-- Summary Metric Cards -->
  <%= render "statusmap/summary_cards" %>

  <!-- Interactive Topology Canvas -->
  <div id="topologyCanvasContainer" class="glass-panel rounded-3xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xl overflow-hidden flex flex-col relative">
    <!-- Toolbar Controls -->
    <%= render "statusmap/toolbar" %>

    <!-- Visual Canvas Viewport -->
    <div id="printableTopologyArea" class="relative bg-[#070B14] p-8 sm:p-12 min-h-[580px] flex flex-col items-center justify-center overflow-hidden select-none">
      <!-- Dark Cyberpunk Grid Canvas Background -->
      <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-40 pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-indigo-950/15 via-transparent to-slate-950/50 pointer-events-none"></div>

      <!-- Zoomable Container Wrapper -->
      <div id="zoomableCanvas" class="relative z-10 w-full flex flex-col items-center transition-transform duration-200 origin-top">
        <!-- Tree Layout Mode -->
        <%= render "statusmap/tree_layout" %>

        <!-- Radial Layout Mode & Search Empty State -->
        <%= render "statusmap/radial_layout" %>
      </div>
    </div>
  </div>

  <!-- Slide-Over Node Inspector Drawer -->
  <%= render "statusmap/inspector_drawer" %>
</div>

<!-- Styles & Client-Side Scripts -->
<%= render "statusmap/scripts" %>
