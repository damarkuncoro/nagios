<div class="max-w-7xl mx-auto space-y-8" data-controller="auto-refresh filter" data-auto-refresh-interval-value="15000">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Network Topology Map</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
          <span>statusmap.cgi engine</span>
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Peta hubungan hierarki topologi jaringan dan server</p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <!-- Node Search Input -->
      <div class="relative">
        <input type="text"
               placeholder="Cari node host..."
               data-filter-target="input"
               data-action="input->filter#search"
               class="px-3.5 py-2 pl-9 text-xs bg-white dark:bg-[#111827] text-slate-800 dark:text-slate-100 border border-slate-200/80 dark:border-slate-800/80 rounded-xl shadow-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 w-52 transition">
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>

      <div class="flex items-center gap-2 px-3.5 py-2 bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border border-emerald-500/20 rounded-xl text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Topology Live Sync</span>
      </div>

      <%= link_to statusmap_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-700 hover:to-indigo-600 text-white font-semibold text-xs rounded-xl shadow-md shadow-indigo-600/20 transition cursor-pointer" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        <span>Refresh Map</span>
      <% end %>
    </div>
  </div>

  <!-- Summary Cards Bar -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="p-6 bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover flex items-center justify-between relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 to-violet-500"></div>
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Root Engine Node</p>
        <p class="text-xl font-extrabold text-slate-900 dark:text-white mt-1.5 font-mono"><%= @map[:root][:name] %></p>
      </div>
      <span class="px-3 py-1 bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 text-xs font-extrabold border border-indigo-500/20 rounded-full font-mono">ACTIVE</span>
    </div>

    <div class="p-6 bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover flex items-center justify-between relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-400"></div>
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Total Host Nodes</p>
        <p class="text-xl font-extrabold text-slate-900 dark:text-white mt-1.5 font-mono"><%= @map[:nodes].size %> Server Nodes</p>
      </div>
      <span class="px-3 py-1 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 text-xs font-extrabold border border-emerald-500/20 rounded-full font-mono">100% ONLINE</span>
    </div>

    <div class="p-6 bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover flex items-center justify-between relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-teal-400 to-emerald-500"></div>
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Sub-Services Health</p>
        <p class="text-xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1.5 font-mono">
          <%= @map[:nodes].sum { |n| n[:ok_services] } %> / <%= @map[:nodes].sum { |n| n[:total_services] } %> OK
        </p>
      </div>
      <span class="px-3 py-1 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 text-xs font-extrabold border border-emerald-500/20 rounded-full font-mono">HEALTHY</span>
    </div>
  </div>

  <!-- Visual Topology Canvas / Nodes -->
  <div class="p-10 bg-[#0B0F19] rounded-3xl shadow-2xl border border-slate-800/80 text-slate-100 flex flex-col items-center space-y-8 min-h-[520px] justify-center relative overflow-hidden">
    <!-- Subtle Grid Pattern Background -->
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-40"></div>

    <!-- Root Node: Nagios Core Server -->
    <div class="p-4 bg-slate-900/90 backdrop-blur-md border-2 border-indigo-500 rounded-2xl flex items-center gap-3.5 shadow-xl shadow-indigo-500/20 z-10 hover:scale-105 transition transform duration-200">
      <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center font-black text-white text-lg shadow-md">
        N
      </div>
      <div>
        <p class="font-bold text-sm text-white font-mono"><%= @map[:root][:name] %></p>
        <p class="text-[11px] text-indigo-400 font-medium">Nagios Core Monitoring Master Engine</p>
      </div>
    </div>

    <!-- Connector Line SVG -->
    <div class="w-full flex justify-center -my-3 z-10">
      <svg class="w-full max-w-lg h-12 text-indigo-500/80" stroke="currentColor" fill="none" viewBox="0 0 400 50">
        <path d="M 200 0 L 200 50" stroke-width="2" stroke-dasharray="4 4" />
      </svg>
    </div>

    <!-- Tier 2: Switch/Gateway Layer Node -->
    <div class="px-5 py-2.5 bg-slate-900/90 backdrop-blur-md border border-slate-700/80 rounded-xl flex items-center gap-2.5 text-xs text-slate-300 shadow-md z-10">
      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
      <span class="font-semibold font-mono">Core Network Gateway Switch (0.0.0.0)</span>
      <span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-400 font-bold font-mono">ONLINE</span>
    </div>

    <!-- Connector Line SVG -->
    <div class="w-full flex justify-center -my-3 z-10">
      <svg class="w-full max-w-lg h-12 text-indigo-500/80" stroke="currentColor" fill="none" viewBox="0 0 400 50">
        <path d="M 200 0 L 200 50" stroke-width="2" stroke-dasharray="4 4" />
      </svg>
    </div>

    <!-- Child Host Nodes Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full max-w-4xl z-10">
      <% @map[:nodes].each do |node| %>
        <div data-filter-target="row" data-status="<%= node[:status] %>" class="p-5 bg-slate-900/90 backdrop-blur-md rounded-2xl border border-slate-800 shadow-lg flex flex-col justify-between space-y-4 hover:border-indigo-500/80 transition-all duration-200 card-hover">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl <%= node[:status] == 'UP' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30' : 'bg-red-500/10 text-red-400 border border-red-500/30' %> flex items-center justify-center font-bold text-xs">
                H
              </div>
              <div>
                <p class="font-bold text-sm text-white font-mono"><%= node[:name] %></p>
                <p class="text-xs text-slate-400 font-medium"><%= node[:ok_services] %> / <%= node[:total_services] %> Services OK</p>
              </div>
            </div>

            <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= node[:status] == 'UP' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30' : 'bg-red-500/10 text-red-400 border border-red-500/30' %> font-mono">
              ● <%= node[:status] %>
            </span>
          </div>

          <p class="text-xs text-slate-400 truncate bg-slate-950/80 p-3 rounded-xl border border-slate-800/80 font-mono">
            <%= node[:plugin_output] %>
          </p>

          <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between gap-2">
            <a href="http://localhost:8080/nagios/cgi-bin/status.cgi?host=<%= node[:name] %>" target="_blank" class="text-xs text-slate-400 hover:text-indigo-400 transition font-medium">
              CGI Detail ↗
            </a>

            <%= button_to recheck_host_path(node[:name]),
                          method: :post,
                          class: "text-xs px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition cursor-pointer shadow-sm" do %>
              Re-check Host
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
