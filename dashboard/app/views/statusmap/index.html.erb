<div class="max-w-6xl mx-auto p-6 space-y-8" data-controller="auto-refresh filter" data-auto-refresh-interval-value="15000">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Network Topology Map</h1>
      <p class="text-slate-500 text-sm mt-1">Peta hubungan hierarki topologi jaringan dan server (*statusmap.cgi*)</p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <!-- Node Search Input -->
      <input type="text"
             placeholder="Cari node host..."
             data-filter-target="input"
             data-action="input->filter#search"
             class="px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 w-48">

      <div class="flex items-center gap-2 px-3.5 py-2 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded-lg text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Topology Live Sync</span>
      </div>

      <%= link_to statusmap_path, class: "flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium text-xs rounded-lg shadow-sm transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        Refresh Map
      <% end %>
    </div>
  </div>

  <!-- Summary Cards Bar -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Root Engine Node</p>
        <p class="text-xl font-bold text-slate-900 mt-1"><%= @map[:root][:name] %></p>
      </div>
      <span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 text-xs font-bold border border-indigo-100 rounded-full">ACTIVE</span>
    </div>

    <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Host Nodes</p>
        <p class="text-xl font-bold text-slate-900 mt-1"><%= @map[:nodes].size %> Server Nodes</p>
      </div>
      <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-100 rounded-full">100% ONLINE</span>
    </div>

    <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Sub-Services Health</p>
        <p class="text-xl font-bold text-emerald-600 mt-1">
          <%= @map[:nodes].sum { |n| n[:ok_services] } %> / <%= @map[:nodes].sum { |n| n[:total_services] } %> OK
        </p>
      </div>
      <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-100 rounded-full">HEALTHY</span>
    </div>
  </div>

  <!-- Visual Topology Canvas / Nodes -->
  <div class="p-8 bg-slate-900 rounded-2xl shadow-xl border border-slate-800 text-slate-100 flex flex-col items-center space-y-8 min-h-[500px] justify-center">
    <!-- Root Node: Nagios Core Server -->
    <div class="p-4 bg-slate-800 border-2 border-indigo-500 rounded-2xl flex items-center gap-3 shadow-lg z-10 hover:scale-105 transition transform">
      <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center font-black text-white text-lg shadow-inner">
        N
      </div>
      <div>
        <p class="font-bold text-sm text-white"><%= @map[:root][:name] %></p>
        <p class="text-xs text-indigo-400 font-semibold">Nagios Core Monitoring Master Engine</p>
      </div>
    </div>

    <!-- Connector Line SVG -->
    <div class="w-full flex justify-center -my-4">
      <svg class="w-full max-w-lg h-12 text-indigo-500" stroke="currentColor" fill="none" viewBox="0 0 400 50">
        <path d="M 200 0 L 200 50" stroke-width="2" stroke-dasharray="4 4" />
      </svg>
    </div>

    <!-- Tier 2: Switch/Gateway Layer Node -->
    <div class="px-4 py-2 bg-slate-800/80 border border-slate-700 rounded-xl flex items-center gap-2 text-xs text-slate-300 shadow">
      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
      <span class="font-semibold">Core Network Gateway Switch (0.0.0.0)</span>
      <span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-400 font-bold">ONLINE</span>
    </div>

    <!-- Connector Line SVG -->
    <div class="w-full flex justify-center -my-4">
      <svg class="w-full max-w-lg h-12 text-indigo-500" stroke="currentColor" fill="none" viewBox="0 0 400 50">
        <path d="M 200 0 L 200 50" stroke-width="2" stroke-dasharray="4 4" />
      </svg>
    </div>

    <!-- Child Host Nodes Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full max-w-4xl z-10">
      <% @map[:nodes].each do |node| %>
        <div data-filter-target="row" data-status="<%= node[:status] %>" class="p-5 bg-slate-800 rounded-xl border border-slate-700 shadow-md flex flex-col justify-between space-y-4 hover:border-indigo-500 transition">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg <%= node[:status] == 'UP' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-red-500/20 text-red-400 border border-red-500/30' %> flex items-center justify-center font-bold text-xs">
                H
              </div>
              <div>
                <p class="font-bold text-sm text-white"><%= node[:name] %></p>
                <p class="text-xs text-slate-400"><%= node[:ok_services] %> / <%= node[:total_services] %> Services OK</p>
              </div>
            </div>

            <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= node[:status] == 'UP' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-red-500/20 text-red-400 border border-red-500/30' %>">
              ● <%= node[:status] %>
            </span>
          </div>

          <p class="text-xs text-slate-400 truncate bg-slate-900/60 p-2.5 rounded-lg border border-slate-800 font-mono">
            <%= node[:plugin_output] %>
          </p>

          <div class="pt-2 border-t border-slate-700/50 flex items-center justify-between gap-2">
            <a href="http://localhost:8080/nagios/cgi-bin/status.cgi?host=<%= node[:name] %>" target="_blank" class="text-[10px] text-slate-400 hover:text-indigo-400 transition">
              CGI Detail ↗
            </a>

            <%= button_to recheck_host_path(node[:name]),
                          method: :post,
                          class: "text-[11px] px-2.5 py-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded transition cursor-pointer" do %>
              Re-check Host
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
