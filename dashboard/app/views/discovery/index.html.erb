<div class="max-w-7xl mx-auto space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Network Autodiscovery</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
          <span>Pure-Ruby Scanner</span>
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Pindai subnet IP untuk mendeteksi Router, Switch, Server, dan integrasikan langsung ke Nagios monitoring engine</p>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-sm font-medium flex items-center gap-2">
      <span>✅</span>
      <span><%= flash[:notice] %></span>
    </div>
  <% elsif flash[:alert] %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-sm font-medium flex items-center gap-2">
      <span>⚠️</span>
      <span><%= flash[:alert] %></span>
    </div>
  <% end %>

  <!-- Scan Control Form -->
  <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 p-6 shadow-xs">
    <%= form_with url: scan_discovery_path, method: :post, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="md:col-span-2">
          <%= f.label :cidr, "Target Subnet CIDR / IP Range", class: "block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1" %>
          <%= f.text_field :cidr, value: @cidr, placeholder: "Contoh: 192.168.1.0/24 atau 127.0.0.1/32", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white text-sm font-mono focus:ring-2 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :community, "SNMP Community", class: "block text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1" %>
          <%= f.text_field :community, value: @community, placeholder: "public", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white text-sm font-mono focus:ring-2 focus:ring-indigo-500" %>
        </div>
        <div class="flex items-end">
          <%= f.submit "🔍 Pindai Jaringan", class: "w-full py-2.5 px-4 bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-700 hover:to-indigo-600 text-white font-bold text-sm rounded-xl shadow-md shadow-indigo-600/20 transition cursor-pointer" %>
        </div>
      </div>
      
      <!-- Preset Quick Links -->
      <div class="flex flex-wrap items-center gap-2 pt-2 text-xs text-slate-500 dark:text-slate-400">
        <span class="font-semibold">Preset Cepat:</span>
        <a href="#" onclick="document.getElementById('cidr').value='192.168.140.0/24'; return false;" class="text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">⚡ LAN Subnet (192.168.140.0/24)</a> •
        <a href="#" onclick="document.getElementById('cidr').value='192.168.140.1/32'; return false;" class="text-indigo-600 dark:text-indigo-400 hover:underline">MikroTik Router (192.168.140.1/32)</a> •
        <a href="#" onclick="document.getElementById('cidr').value='192.168.140.200/32'; return false;" class="text-indigo-600 dark:text-indigo-400 hover:underline">Ruijie AP (192.168.140.200/32)</a> •
        <a href="#" onclick="document.getElementById('cidr').value='127.0.0.1/32'; return false;" class="text-indigo-600 dark:text-indigo-400 hover:underline">Localhost (127.0.0.1/32)</a>
      </div>
    <% end %>
  </div>

  <!-- Discovered Devices Section -->
  <div class="space-y-4">
    <div class="flex justify-between items-center">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">
        Hasil Pemindaian Subnet 
        <% if @duration %>
          <span class="text-xs font-normal text-slate-500 dark:text-slate-400">(Selesai dalam <%= @duration %> detik, ditemukan <%= @devices.size %> perangkat)</span>
        <% end %>
      </h2>
    </div>

    <% if @devices.empty? %>
      <div class="p-12 bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 text-center shadow-xs">
        <div class="w-12 h-12 mx-auto rounded-full bg-indigo-500/10 flex items-center justify-center text-indigo-600 dark:text-indigo-400 mb-3 text-xl font-bold">
          🌐
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Belum Ada Hasil Pemindaian</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-md mx-auto">
          Masukkan range CIDR subnet di atas lalu klik tombol <b>Pindai Jaringan</b> untuk mendeteksi perangkat router, switch, dan host secara otomatis.
        </p>
      </div>
    <% else %>
      <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                <th class="py-3 px-4">IP Address</th>
                <th class="py-3 px-4">Hostname</th>
                <th class="py-3 px-4">Vendor & Tipe</th>
                <th class="py-3 px-4">Port Terbuka</th>
                <th class="py-3 px-4">Latensi</th>
                <th class="py-3 px-4 text-right">Status / Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-sm">
              <% @devices.each do |dev| %>
                <% is_monitored = (@monitored_ips || []).include?(dev.ip) %>
                <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/30 transition">
                  <td class="py-3.5 px-4 font-mono font-bold text-slate-900 dark:text-white">
                    <%= dev.ip %>
                  </td>
                  <td class="py-3.5 px-4 text-slate-600 dark:text-slate-300 font-medium">
                    <%= dev.hostname %>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20">
                      <%= dev.vendor %>
                    </span>
                    <span class="text-xs text-slate-500 dark:text-slate-400 ml-1">
                      <%= dev.device_type %>
                    </span>
                    <% if dev.snmp_descr.present? %>
                      <div class="text-[11px] text-slate-400 font-mono mt-0.5 truncate max-w-xs" title="<%= dev.snmp_descr %>">
                        SNMP: <%= dev.snmp_descr %>
                      </div>
                    <% end %>
                  </td>
                  <td class="py-3.5 px-4">
                    <div class="flex flex-wrap gap-1">
                      <% dev.open_ports.each do |port| %>
                        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                          <%= port %>
                        </span>
                      <% end %>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 font-mono text-emerald-600 dark:text-emerald-400 font-semibold text-xs">
                    <%= dev.latency_ms %> ms
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    <% if is_monitored %>
                      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 shadow-xs">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span>Terpantau Aktif</span>
                      </span>
                    <% else %>
                      <%= button_to import_discovery_path(ip: dev.ip, hostname: dev.hostname, vendor: dev.vendor, device_type: dev.device_type, snmp_descr: dev.snmp_descr, open_ports: dev.open_ports.join(','), cidr: @cidr), method: :post, class: "inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-xs transition cursor-pointer" do %>
                        <span>➕ Tambah ke Monitoring</span>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
</div>
