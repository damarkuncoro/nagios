<div class="max-w-6xl mx-auto p-6 space-y-8">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Scheduled Downtimes</h1>
      <p class="text-slate-500 text-sm mt-1">Daftar pemeliharaan server yang terjadwal</p>
    </div>
  </div>

  <% if notice.present? %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-lg text-sm font-medium">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
          <th class="py-3.5 px-6">ID</th>
          <th class="py-3.5 px-6">Host / Service</th>
          <th class="py-3.5 px-6">Author & Komentar</th>
          <th class="py-3.5 px-6">Mulai</th>
          <th class="py-3.5 px-6">Selesai</th>
          <th class="py-3.5 px-6 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @downtimes.empty? %>
          <tr>
            <td colspan="6" class="py-12 px-6 text-center text-slate-400">
              <p class="font-semibold text-slate-600">Tidak ada Scheduled Downtime aktif saat ini.</p>
            </td>
          </tr>
        <% else %>
          <% @downtimes.each do |dt| %>
            <tr class="hover:bg-slate-50 transition">
              <td class="py-4 px-6 text-sm font-mono text-slate-500">
                #<%= dt[:id] %>
              </td>
              <td class="py-4 px-6 text-sm font-semibold text-slate-800">
                <%= dt[:host_name] %> <%= dt[:service_description].present? ? "/ #{dt[:service_description]}" : "" %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-600">
                <span class="font-medium text-slate-800"><%= dt[:author] %></span>: "<%= dt[:comment] %>"
              </td>
              <td class="py-4 px-6 text-sm text-slate-500 font-mono">
                <%= dt[:start_time].strftime("%H:%M:%S (%d %b)") %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-500 font-mono">
                <%= dt[:end_time].strftime("%H:%M:%S (%d %b)") %>
              </td>
              <td class="py-4 px-6 text-right">
                <%= button_to downtime_path(dt[:id]),
                              method: :delete,
                              class: "text-xs px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 font-medium rounded-md transition border border-red-200 cursor-pointer" do %>
                  Batalkan Downtime
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
