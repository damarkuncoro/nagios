<div class="max-w-6xl mx-auto space-y-8">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Scheduled Downtimes</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Daftar pemeliharaan server dan layanan yang terjadwal (*extinfo.cgi?type=6*)</p>
    </div>
  </div>

  <% if notice.present? %>
    <div class="p-4 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 rounded-lg text-sm font-medium">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
          <th class="py-3.5 px-6">ID</th>
          <th class="py-3.5 px-6">Host / Service</th>
          <th class="py-3.5 px-6">Author & Komentar</th>
          <th class="py-3.5 px-6">Mulai</th>
          <th class="py-3.5 px-6">Selesai</th>
          <th class="py-3.5 px-6 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <% if @downtimes.empty? %>
          <tr>
            <td colspan="6" class="py-12 px-6 text-center text-slate-400 dark:text-slate-500">
              <p class="font-semibold">Tidak ada Scheduled Downtime aktif saat ini.</p>
            </td>
          </tr>
        <% else %>
          <% @downtimes.each do |dt| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
              <td class="py-4 px-6 text-sm font-mono text-slate-500 dark:text-slate-400">
                #<%= dt[:id] %>
              </td>
              <td class="py-4 px-6 text-sm font-semibold text-slate-800 dark:text-slate-200">
                <%= link_to dt[:host_name], host_path(dt[:host_name]), class: "hover:text-indigo-600 dark:hover:text-indigo-400 hover:underline" %>
                <% if dt[:service_description].present? %>
                  <span class="text-slate-400 text-xs block font-normal"><%= dt[:service_description] %></span>
                <% end %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-600 dark:text-slate-300">
                <span class="font-medium text-slate-800 dark:text-slate-200"><%= dt[:author] %></span>: "<%= dt[:comment] %>"
              </td>
              <td class="py-4 px-6 text-sm text-slate-500 dark:text-slate-400 font-mono text-xs">
                <%= dt[:start_time].strftime("%H:%M:%S (%d %b)") %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-500 dark:text-slate-400 font-mono text-xs">
                <%= dt[:end_time].strftime("%H:%M:%S (%d %b)") %>
              </td>
              <td class="py-4 px-6 text-right">
                <%= button_to downtime_path(dt[:id]),
                              method: :delete,
                              data: { turbo_confirm: "Hapus downtime maintenance ini?" },
                              class: "text-xs px-2.5 py-1 text-rose-600 dark:text-rose-400 hover:text-rose-800 dark:hover:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950 font-medium rounded transition cursor-pointer" do %>
                  Batalkan
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
