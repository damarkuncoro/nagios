<div class="max-w-7xl mx-auto space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Scheduled Downtimes</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20">
          Maintenance Windows
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Daftar pemeliharaan server dan layanan yang terjadwal (<span class="font-mono text-xs">extinfo.cgi?type=6</span>)</p>
    </div>
  </div>

  <% if notice.present? %>
    <div class="p-4 bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 dark:text-emerald-200 rounded-2xl text-sm font-medium flex items-center gap-3">
      <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <!-- Downtimes Table Card -->
  <div class="glass-panel rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden">
    <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">Active Maintenance Windows</h3>
        <span class="text-xs px-2 py-0.5 rounded-full bg-slate-200/70 dark:bg-slate-700/70 text-slate-700 dark:text-slate-300 font-mono"><%= @downtimes.size %> active</span>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50/50 dark:bg-slate-800/30 border-b border-slate-200/80 dark:border-slate-800/80 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-6">ID</th>
            <th class="py-3.5 px-6">Host / Service</th>
            <th class="py-3.5 px-6">Author & Komentar</th>
            <th class="py-3.5 px-6">Mulai</th>
            <th class="py-3.5 px-6">Selesai</th>
            <th class="py-3.5 px-6 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
          <% if @downtimes.empty? %>
            <tr>
              <td colspan="6" class="py-14 px-6 text-center text-slate-400 dark:text-slate-500">
                <svg class="w-8 h-8 mx-auto text-slate-300 dark:text-slate-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <p class="font-semibold text-sm">Tidak ada Scheduled Downtime aktif saat ini.</p>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Semua host dan service beroperasi dalam mode monitoring normal.</p>
              </td>
            </tr>
          <% else %>
            <% @downtimes.each do |dt| %>
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                <td class="py-4 px-6 text-xs font-mono text-slate-500 dark:text-slate-400">
                  #<%= dt[:id] %>
                </td>
                <td class="py-4 px-6 text-sm font-semibold text-slate-800 dark:text-slate-200">
                  <%= link_to dt[:host_name], host_path(dt[:host_name]), class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 hover:underline transition" %>
                  <% if dt[:service_description].present? %>
                    <span class="text-slate-400 dark:text-slate-500 text-xs block font-normal mt-0.5"><%= dt[:service_description] %></span>
                  <% end %>
                </td>
                <td class="py-4 px-6 text-sm text-slate-600 dark:text-slate-300">
                  <span class="font-semibold text-slate-800 dark:text-slate-200">👤 <%= dt[:author] %></span>: 
                  <span class="italic text-slate-700 dark:text-slate-300">"<%= dt[:comment] %>"</span>
                </td>
                <td class="py-4 px-6 text-xs text-slate-500 dark:text-slate-400 font-mono">
                  <%= dt[:start_time].strftime("%H:%M:%S (%d %b)") %>
                </td>
                <td class="py-4 px-6 text-xs text-slate-500 dark:text-slate-400 font-mono">
                  <%= dt[:end_time].strftime("%H:%M:%S (%d %b)") %>
                </td>
                <td class="py-4 px-6 text-right">
                  <%= button_to downtime_path(dt[:id]),
                                method: :delete,
                                data: { turbo_confirm: "Hapus downtime maintenance ini?" },
                                class: "text-xs px-3 py-1.5 text-rose-600 dark:text-rose-400 hover:text-rose-800 dark:hover:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/60 border border-rose-200/50 dark:border-rose-900/40 font-medium rounded-lg transition cursor-pointer" do %>
                    Batalkan
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
