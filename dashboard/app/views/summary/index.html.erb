<div class="max-w-7xl mx-auto space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Top Incidents & Alert Totals</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20">
          Telemetry & Analytics
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Ringkasan analitik host & service bermasalah beserta histogram distribusi insiden 24 jam (<span class="font-mono text-xs">summary.cgi</span> & <span class="font-mono text-xs">histogram.cgi</span>)</p>
    </div>
  </div>

  <% totals = @summary[:totals] %>
  <% if totals %>
    <!-- Alert Totals Metrics Overview (summary.cgi display_alert_totals) -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="glass-panel p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 to-violet-500"></div>
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total 24h Alerts</p>
        <p class="text-3xl font-black text-slate-800 dark:text-slate-100 mt-1"><%= totals.total %></p>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 font-mono"><%= totals.host_total %> Host / <%= totals.service_total %> Service</p>
      </div>

      <div class="glass-panel p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-rose-500 to-pink-500"></div>
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Critical / Down</p>
        <p class="text-3xl font-black text-rose-500 mt-1"><%= totals.critical_total %></p>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">High severity events</p>
      </div>

      <div class="glass-panel p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 to-orange-400"></div>
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Warnings & Soft</p>
        <p class="text-3xl font-black text-amber-500 mt-1"><%= totals.warning_total %></p>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 font-mono"><%= totals.soft_total %> Soft state retries</p>
      </div>

      <div class="glass-panel p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs card-hover relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-400"></div>
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Recoveries</p>
        <p class="text-3xl font-black text-emerald-500 mt-1"><%= totals.recovery_total %></p>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 font-mono"><%= totals.hard_total %> Hard state alerts</p>
      </div>
    </div>
  <% end %>

  <% histogram = @summary[:histogram] %>
  <% if histogram && histogram.hourly_slots.any? %>
    <% max_hourly = histogram.hourly_slots.map(&:total).max || 1 %>
    <% max_hourly = 1 if max_hourly.zero? %>
    
    <!-- 24-Hour Failure Histogram (histogram.cgi) -->
    <div class="glass-panel rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden">
      <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-200/80 dark:border-slate-800/80 flex flex-wrap justify-between items-center gap-3">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
          <h3 class="font-bold text-slate-800 dark:text-slate-100 text-lg">24-Hour Alert Distribution Timeline</h3>
          <span class="text-xs text-slate-400 dark:text-slate-500 font-mono">(histogram.cgi)</span>
        </div>
        <div class="flex items-center gap-3">
          <% if histogram.peak_hour_count > 0 %>
            <span class="px-3 py-1 bg-rose-500/10 text-rose-700 dark:text-rose-400 text-xs font-semibold rounded-full border border-rose-500/20 font-mono">
              ⚡ Peak: <%= histogram.peak_hour_label %> (<%= histogram.peak_hour_count %> alerts)
            </span>
          <% end %>
          <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Critical</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> Warning</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> OK</span>
          </div>
        </div>
      </div>

      <div class="p-6">
        <!-- Visual Bars -->
        <div class="h-44 flex items-end gap-1.5 sm:gap-2 pt-6 pb-2 border-b border-slate-100 dark:border-slate-800/80">
          <% histogram.hourly_slots.each do |slot| %>
            <% 
              crit_pct = (slot.critical_count.to_f / max_hourly * 100).round
              warn_pct = (slot.warning_count.to_f / max_hourly * 100).round
              ok_pct = (slot.ok_count.to_f / max_hourly * 100).round
              total_pct = [((slot.total.to_f / max_hourly) * 100).round, 4].max if slot.total > 0
            %>
            <div class="flex-1 flex flex-col justify-end items-center h-full group relative" title="<%= slot.hour_label %>: <%= slot.total %> alerts (Crit: <%= slot.critical_count %>, Warn: <%= slot.warning_count %>, OK: <%= slot.ok_count %>)">
              <!-- Tooltip popup on hover -->
              <div class="opacity-0 group-hover:opacity-100 transition-opacity absolute bottom-full mb-2 z-10 px-2.5 py-1 text-[11px] font-mono bg-slate-900 text-white rounded-lg shadow-lg border border-slate-700 pointer-events-none whitespace-nowrap">
                <%= slot.hour_label %>: <%= slot.total %> alerts
              </div>

              <% if slot.total > 0 %>
                <div class="w-full rounded-t-sm flex flex-col justify-end overflow-hidden transition-all duration-300 group-hover:brightness-110" style="height: <%= total_pct %>%;">
                  <% if slot.critical_count > 0 %>
                    <div class="bg-rose-500 hover:bg-rose-400 transition-colors w-full" style="height: <%= (slot.critical_count.to_f / slot.total * 100).round %>%;"></div>
                  <% end %>
                  <% if slot.warning_count > 0 %>
                    <div class="bg-amber-400 hover:bg-amber-300 transition-colors w-full" style="height: <%= (slot.warning_count.to_f / slot.total * 100).round %>%;"></div>
                  <% end %>
                  <% if slot.ok_count > 0 %>
                    <div class="bg-emerald-500 hover:bg-emerald-400 transition-colors w-full" style="height: <%= (slot.ok_count.to_f / slot.total * 100).round %>%;"></div>
                  <% end %>
                </div>
              <% else %>
                <div class="w-full h-1 bg-slate-100 dark:bg-slate-800/80 rounded"></div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Hourly Labels -->
        <div class="flex justify-between items-center text-[10px] text-slate-400 dark:text-slate-500 pt-3 font-mono">
          <span>00:00</span>
          <span>04:00</span>
          <span>08:00</span>
          <span>12:00</span>
          <span>16:00</span>
          <span>20:00</span>
          <span>23:00</span>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Top Monitored Services Failures -->
    <div class="glass-panel rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
      <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-200/80 dark:border-slate-800/80 flex justify-between items-center">
        <h3 class="font-bold text-slate-800 dark:text-slate-100 text-base">Top Problematic Services</h3>
        <span class="px-3 py-1 bg-amber-500/10 text-amber-700 dark:text-amber-400 text-xs font-semibold rounded-full border border-amber-500/20 font-mono">24h History</span>
      </div>

      <div class="p-6 divide-y divide-slate-100 dark:divide-slate-800/60">
        <% if @summary[:top_services].empty? %>
          <div class="py-8 text-center text-slate-400 dark:text-slate-500 font-medium text-sm">
            ✓ Tidak ada riwayat insiden service dalam 24 jam terakhir.
          </div>
        <% else %>
          <% @summary[:top_services].each do |service_name, count| %>
            <div class="py-3.5 first:pt-0 last:pb-0 flex items-center justify-between">
              <span class="font-semibold text-slate-800 dark:text-slate-200 text-sm"><%= service_name %></span>
              <span class="px-3 py-1 bg-rose-500/10 text-rose-700 dark:text-rose-400 font-mono font-bold text-xs rounded-full border border-rose-500/20"><%= count %> Alert</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Top Monitored Hosts Failures -->
    <div class="glass-panel rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden card-hover">
      <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-200/80 dark:border-slate-800/80 flex justify-between items-center">
        <h3 class="font-bold text-slate-800 dark:text-slate-100 text-base">Top Problematic Hosts</h3>
        <span class="px-3 py-1 bg-amber-500/10 text-amber-700 dark:text-amber-400 text-xs font-semibold rounded-full border border-amber-500/20 font-mono">24h History</span>
      </div>

      <div class="p-6 divide-y divide-slate-100 dark:divide-slate-800/60">
        <% if @summary[:top_hosts].empty? %>
          <div class="py-8 text-center text-slate-400 dark:text-slate-500 font-medium text-sm">
            ✓ Tidak ada riwayat insiden host dalam 24 jam terakhir.
          </div>
        <% else %>
          <% @summary[:top_hosts].each do |host_name, count| %>
            <div class="py-3.5 first:pt-0 last:pb-0 flex items-center justify-between">
              <span class="font-semibold text-slate-800 dark:text-slate-200 text-sm">
                <%= link_to host_name, host_path(host_name), class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 hover:underline transition" %>
              </span>
              <span class="px-3 py-1 bg-rose-500/10 text-rose-700 dark:text-rose-400 font-mono font-bold text-xs rounded-full border border-rose-500/20"><%= count %> Alert</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
