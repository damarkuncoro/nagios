<div class="max-w-6xl mx-auto space-y-8">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Comments Manager</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Daftar komentar dan catatan penanganan insiden pada host atau service (*extinfo.cgi?type=3*)</p>
    </div>
  </div>

  <% if notice.present? %>
    <div class="p-4 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 rounded-lg text-sm font-medium">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="p-4 bg-rose-50 dark:bg-rose-950/70 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-200 rounded-lg text-sm font-medium">
      <%= alert %>
    </div>
  <% end %>

  <!-- Add Comment Form Card -->
  <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 p-6 space-y-4">
    <h3 class="font-bold text-slate-800 dark:text-slate-200 text-lg">Tambah Catatan Insiden Baru</h3>

    <%= form_with url: comments_path, method: :post, class: "grid grid-cols-1 sm:grid-cols-4 gap-4" do |f| %>
      <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Host Name</label>
        <%= f.select :host_name, options_for_select(@hosts.map { |h| h[:name] }), {}, class: "w-full text-xs p-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Service (Opsional)</label>
        <%= f.select :service_desc, options_for_select([["— Catatan Host Langsung —", ""]] + @services.map { |s| [s[:description], s[:description]] }.uniq), {}, class: "w-full text-xs p-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Pesan Catatan / Komentar</label>
        <%= f.text_field :comment, placeholder: "Misal: Dalam penanganan oleh tim On-Call", class: "w-full text-xs p-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 rounded-lg placeholder-slate-400 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div class="flex items-end">
        <%= f.submit "+ Simpan Catatan", class: "w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold text-xs rounded-lg shadow-xs transition cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
          <th class="py-3.5 px-6">ID</th>
          <th class="py-3.5 px-6">Host / Service</th>
          <th class="py-3.5 px-6">Author</th>
          <th class="py-3.5 px-6">Komentar</th>
          <th class="py-3.5 px-6">Waktu Dibuat</th>
          <th class="py-3.5 px-6 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <% if @comments.empty? %>
          <tr>
            <td colspan="6" class="py-12 px-6 text-center text-slate-400 dark:text-slate-500">
              <p class="font-semibold">Belum ada catatan komentar tersimpan.</p>
            </td>
          </tr>
        <% else %>
          <% @comments.each do |c| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
              <td class="py-4 px-6 text-sm font-mono text-slate-500 dark:text-slate-400">
                #<%= c[:id] %>
              </td>
              <td class="py-4 px-6 text-sm font-semibold text-slate-800 dark:text-slate-200">
                <%= link_to c[:host_name], host_path(c[:host_name]), class: "hover:text-indigo-600 dark:hover:text-indigo-400 hover:underline" %>
                <% if c[:service_description].present? %>
                  <span class="text-slate-400 text-xs block font-normal"><%= c[:service_description] %></span>
                <% end %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-600 dark:text-slate-300 font-medium">
                <%= c[:author] %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-800 dark:text-slate-200">
                "<%= c[:comment] %>"
              </td>
              <td class="py-4 px-6 text-sm text-slate-500 dark:text-slate-400 font-mono text-xs">
                <%= c[:entry_time].strftime("%H:%M:%S (%d %b %Y)") %>
              </td>
              <td class="py-4 px-6 text-right">
                <%= button_to comment_path(c[:id]),
                              method: :delete,
                              data: { turbo_confirm: "Hapus catatan ini?" },
                              class: "text-xs px-2.5 py-1 text-rose-600 dark:text-rose-400 hover:text-rose-800 dark:hover:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950 font-medium rounded transition cursor-pointer" do %>
                  Hapus
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
