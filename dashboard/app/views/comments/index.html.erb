<div class="max-w-6xl mx-auto p-6 space-y-8">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Comments Manager</h1>
      <p class="text-slate-500 text-sm mt-1">Daftar komentar dan catatan penanganan insiden pada host atau service</p>
    </div>
  </div>

  <% if notice.present? %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-lg text-sm font-medium">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm font-medium">
      <%= alert %>
    </div>
  <% end %>

  <!-- Add Comment Form Card -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-4">
    <h3 class="font-bold text-slate-800 text-lg">Tambah Catatan Insiden Baru</h3>

    <%= form_with url: comments_path, method: :post, class: "grid grid-cols-1 sm:grid-cols-4 gap-4" do |f| %>
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Host Name</label>
        <%= f.select :host_name, options_for_select(@hosts.map { |h| h[:name] }), {}, class: "w-full text-xs p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Service Description</label>
        <%= f.select :service_desc, options_for_select(@services.map { |s| s[:description] }.uniq), {}, class: "w-full text-xs p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Pesan Catatan / Komentar</label>
        <%= f.text_field :comment, placeholder: "Misal: Dalam penanganan oleh tim On-Call", class: "w-full text-xs p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div class="flex items-end">
        <%= f.submit "+ Simpan Catatan", class: "w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold text-xs rounded-lg shadow-sm transition cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
          <th class="py-3.5 px-6">ID</th>
          <th class="py-3.5 px-6">Host / Service</th>
          <th class="py-3.5 px-6">Author</th>
          <th class="py-3.5 px-6">Komentar</th>
          <th class="py-3.5 px-6">Waktu Dibuat</th>
          <th class="py-3.5 px-6 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @comments.empty? %>
          <tr>
            <td colspan="6" class="py-12 px-6 text-center text-slate-400">
              <p class="font-semibold text-slate-600">Tidak ada komentar aktif saat ini.</p>
            </td>
          </tr>
        <% else %>
          <% @comments.each do |c| %>
            <tr class="hover:bg-slate-50 transition">
              <td class="py-4 px-6 text-sm font-mono text-slate-500">
                #<%= c[:id] %>
              </td>
              <td class="py-4 px-6 text-sm font-semibold text-slate-800">
                <%= c[:host_name] %> <%= c[:service_description].present? ? "/ #{c[:service_description]}" : "" %>
              </td>
              <td class="py-4 px-6 text-sm font-medium text-slate-700">
                <%= c[:author] %>
              </td>
              <td class="py-4 px-6 text-sm text-slate-600 max-w-xs truncate">
                "<%= c[:comment] %>"
              </td>
              <td class="py-4 px-6 text-sm text-slate-500 font-mono">
                <%= c[:entry_time].strftime("%H:%M:%S (%d %b)") %>
              </td>
              <td class="py-4 px-6 text-right">
                <%= button_to comment_path(c[:id]),
                              method: :delete,
                              class: "text-xs px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 font-medium rounded-md transition border border-red-200 cursor-pointer" do %>
                  Hapus Komentar
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
