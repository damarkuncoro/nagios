<div class="max-w-7xl mx-auto space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Comments Manager</h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20">
          Incident Notes
        </span>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Daftar komentar dan catatan penanganan insiden pada host atau service (<span class="font-mono text-xs">extinfo.cgi?type=3</span>)</p>
    </div>
  </div>

  <% if notice.present? %>
    <div class="p-4 bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 dark:text-emerald-200 rounded-2xl text-sm font-medium flex items-center gap-3">
      <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="p-4 bg-rose-500/10 border border-rose-500/30 text-rose-800 dark:text-rose-200 rounded-2xl text-sm font-medium flex items-center gap-3">
      <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= alert %></span>
    </div>
  <% end %>

  <!-- Add Comment Form Card -->
  <div class="glass-panel p-6 sm:p-7 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs space-y-4">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-sm">
        ✏️
      </div>
      <div>
        <h3 class="font-bold text-slate-800 dark:text-slate-100 text-base">Tambah Catatan Insiden Baru</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">Sisipkan catatan investigasi atau follow-up insiden untuk host & service terkait</p>
      </div>
    </div>

    <%= form_with url: comments_path, method: :post, class: "grid grid-cols-1 sm:grid-cols-4 gap-4 pt-2" do |f| %>
      <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Host Name</label>
        <%= f.select :host_name, options_for_select(@hosts.map { |h| h[:name] }), {}, class: "w-full text-xs p-2.5 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700/80 rounded-xl focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 focus:outline-none transition" %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Service (Opsional)</label>
        <%= f.select :service_desc, options_for_select([["— Catatan Host Langsung —", ""]] + @services.map { |s| [s[:description], s[:description]] }.uniq), {}, class: "w-full text-xs p-2.5 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700/80 rounded-xl focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 focus:outline-none transition" %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1.5">Pesan Catatan / Komentar</label>
        <%= f.text_field :comment, placeholder: "Misal: Sedang diinvestigasi oleh tim On-Call", class: "w-full text-xs p-2.5 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700/80 rounded-xl placeholder-slate-400 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 focus:outline-none transition" %>
      </div>

      <div class="flex items-end">
        <%= f.submit "+ Simpan Catatan", class: "w-full py-2.5 px-4 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:from-indigo-700 active:to-violet-700 text-white font-semibold text-xs rounded-xl shadow-xs hover:shadow-indigo-500/20 transition cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Comments Table -->
  <div class="glass-panel rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-xs overflow-hidden">
    <div class="px-6 py-4 bg-slate-50/70 dark:bg-slate-800/40 border-b border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">Log Catatan Tersimpan</h3>
        <span class="text-xs px-2 py-0.5 rounded-full bg-slate-200/70 dark:bg-slate-700/70 text-slate-700 dark:text-slate-300 font-mono"><%= @comments.size %> entries</span>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50/50 dark:bg-slate-800/30 border-b border-slate-200/80 dark:border-slate-800/80 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-6">ID</th>
            <th class="py-3.5 px-6">Host / Service</th>
            <th class="py-3.5 px-6">Author</th>
            <th class="py-3.5 px-6">Komentar</th>
            <th class="py-3.5 px-6">Waktu Dibuat</th>
            <th class="py-3.5 px-6 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
          <% if @comments.empty? %>
            <tr>
              <td colspan="6" class="py-14 px-6 text-center text-slate-400 dark:text-slate-500">
                <svg class="w-8 h-8 mx-auto text-slate-300 dark:text-slate-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                <p class="font-semibold text-sm">Belum ada catatan komentar tersimpan.</p>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Gunakan form di atas untuk menambahkan catatan insiden baru.</p>
              </td>
            </tr>
          <% else %>
            <% @comments.each do |c| %>
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                <td class="py-4 px-6 text-xs font-mono text-slate-500 dark:text-slate-400">
                  #<%= c[:id] %>
                </td>
                <td class="py-4 px-6 text-sm font-semibold text-slate-800 dark:text-slate-200">
                  <%= link_to c[:host_name], host_path(c[:host_name]), class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 hover:underline transition" %>
                  <% if c[:service_description].present? %>
                    <span class="text-slate-400 dark:text-slate-500 text-xs block font-normal mt-0.5"><%= c[:service_description] %></span>
                  <% end %>
                </td>
                <td class="py-4 px-6 text-sm text-slate-600 dark:text-slate-300">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800/80 font-mono text-xs text-slate-700 dark:text-slate-300 border border-slate-200/50 dark:border-slate-700/50">
                    👤 <%= c[:author] %>
                  </span>
                </td>
                <td class="py-4 px-6 text-sm text-slate-800 dark:text-slate-200">
                  <span class="italic font-medium">"<%= c[:comment] %>"</span>
                </td>
                <td class="py-4 px-6 text-xs text-slate-500 dark:text-slate-400 font-mono">
                  <%= c[:entry_time].strftime("%H:%M:%S (%d %b %Y)") %>
                </td>
                <td class="py-4 px-6 text-right">
                  <%= button_to comment_path(c[:id]),
                                method: :delete,
                                data: { turbo_confirm: "Hapus catatan ini?" },
                                class: "text-xs px-3 py-1.5 text-rose-600 dark:text-rose-400 hover:text-rose-800 dark:hover:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/60 border border-rose-200/50 dark:border-rose-900/40 font-medium rounded-lg transition cursor-pointer" do %>
                    Hapus
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
