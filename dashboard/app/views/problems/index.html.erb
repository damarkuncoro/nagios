<div class="max-w-6xl mx-auto p-6 space-y-8" data-controller="auto-refresh" data-auto-refresh-interval-value="15000">
  <div class="flex justify-between items-center">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Unhandled Problems Center</h1>
        <% if @problems[:total_unhandled] > 0 %>
          <span class="px-3 py-1 rounded-full text-xs font-black bg-red-600 text-white animate-bounce">
            <%= @problems[:total_unhandled] %> INSIDEN
          </span>
        <% else %>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
            ALL CLEAR
          </span>
        <% end %>
      </div>
      <p class="text-slate-500 text-sm mt-1">Pusat penanganan masalah host & service yang belum di-acknowledge</p>
    </div>

    <%= link_to problems_path, class: "flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium text-sm rounded-lg shadow-sm transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
      Refresh
    <% end %>
  </div>

  <% if notice.present? %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-lg text-sm font-medium">
      <%= notice %>
    </div>
  <% end %>

  <!-- Unhandled Host Problems -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
      <span>Unhandled Hosts</span>
      <span class="text-xs px-2 py-0.5 rounded bg-slate-200 text-slate-700"><%= @problems[:hosts].size %></span>
    </h2>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
            <th class="py-3.5 px-6">Host Name</th>
            <th class="py-3.5 px-6">Status</th>
            <th class="py-3.5 px-6">Plugin Output</th>
            <th class="py-3.5 px-6">Terakhir Dicek</th>
            <th class="py-3.5 px-6 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if @problems[:hosts].empty? %>
            <tr>
              <td colspan="5" class="py-8 px-6 text-center text-slate-400">
                <p class="font-medium text-emerald-600">✓ Seluruh Host berstatus normal atau telah di-acknowledge.</p>
              </td>
            </tr>
          <% else %>
            <% @problems[:hosts].each do |host| %>
              <%= render "hosts/host_row", host: host %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Unhandled Service Problems -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
      <span>Unhandled Services</span>
      <span class="text-xs px-2 py-0.5 rounded bg-slate-200 text-slate-700"><%= @problems[:services].size %></span>
    </h2>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
            <th class="py-3.5 px-6">Host</th>
            <th class="py-3.5 px-6">Service</th>
            <th class="py-3.5 px-6">Status</th>
            <th class="py-3.5 px-6">Plugin Output</th>
            <th class="py-3.5 px-6">Terakhir Dicek</th>
            <th class="py-3.5 px-6 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if @problems[:services].empty? %>
            <tr>
              <td colspan="6" class="py-8 px-6 text-center text-slate-400">
                <p class="font-medium text-emerald-600">✓ Seluruh Service berstatus normal atau telah di-acknowledge.</p>
              </td>
            </tr>
          <% else %>
            <% @problems[:services].each do |service| %>
              <%= render "hosts/service_row", service: service %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
