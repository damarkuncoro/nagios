<div class="max-w-6xl mx-auto space-y-8" data-controller="auto-refresh" data-auto-refresh-interval-value="15000">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Unhandled Problems Center</h1>
        <% if @problems[:total_unhandled] > 0 %>
          <span class="px-3 py-1 rounded-full text-xs font-black bg-rose-600 text-white animate-bounce">
            <%= @problems[:total_unhandled] %> INSIDEN
          </span>
        <% else %>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
            ALL CLEAR
          </span>
        <% end %>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Pusat penanganan masalah host & service yang belum di-acknowledge</p>
    </div>

    <%= link_to problems_path, class: "flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium text-xs rounded-lg shadow-xs transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
      Refresh
    <% end %>
  </div>

  <!-- Filter Pills -->
  <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-2">
    <%= link_to "Semua Masalah", problems_path,
                class: "px-3 py-1.5 rounded-lg text-xs font-semibold transition #{ @filter.blank? ? 'bg-indigo-600 text-white shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800' }" %>
    <%= link_to problems_path(filter: 'flapping'),
                class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition #{ @filter == 'flapping' ? 'bg-purple-600 text-white shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800' }" do %>
      <span>🔀 Flapping Objects</span>
      <span class="px-1.5 py-0.2 rounded-full text-[10px] <%= @filter == 'flapping' ? 'bg-purple-700 text-white' : 'bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300' %>">
        <%= @problems[:total_flapping] %>
      </span>
    <% end %>
  </div>

  <% if notice.present? %>
    <div class="p-4 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 rounded-lg text-sm font-medium">
      <%= notice %>
    </div>
  <% end %>

  <!-- Unhandled Host Problems -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-slate-800 dark:text-slate-200 flex items-center gap-2">
      <span>Unhandled Hosts</span>
      <span class="text-xs px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-mono"><%= @problems[:hosts].size %></span>
    </h2>

    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-6">Host Name</th>
            <th class="py-3.5 px-6">Status</th>
            <th class="py-3.5 px-6">Plugin Output</th>
            <th class="py-3.5 px-6">Terakhir Dicek</th>
            <th class="py-3.5 px-6 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <% if @problems[:hosts].empty? %>
            <tr>
              <td colspan="5" class="py-8 px-6 text-center text-slate-400 dark:text-slate-500">
                <p class="font-medium text-emerald-600 dark:text-emerald-400">✓ Seluruh Host berstatus normal atau telah di-acknowledge.</p>
              </td>
            </tr>
          <% else %>
            <% @problems[:hosts].each do |host| %>
              <%= render "hosts/host_row", host: host %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Unhandled Service Problems -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-slate-800 dark:text-slate-200 flex items-center gap-2">
      <span>Unhandled Services</span>
      <span class="text-xs px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-mono"><%= @problems[:services].size %></span>
    </h2>

    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs border border-slate-200 dark:border-slate-800 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-6">Host</th>
            <th class="py-3.5 px-6">Service</th>
            <th class="py-3.5 px-6">Status</th>
            <th class="py-3.5 px-6">Plugin Output</th>
            <th class="py-3.5 px-6">Terakhir Dicek</th>
            <th class="py-3.5 px-6 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <% if @problems[:services].empty? %>
            <tr>
              <td colspan="6" class="py-8 px-6 text-center text-slate-400 dark:text-slate-500">
                <p class="font-medium text-emerald-600 dark:text-emerald-400">✓ Seluruh Service berstatus normal atau telah di-acknowledge.</p>
              </td>
            </tr>
          <% else %>
            <% @problems[:services].each do |service| %>
              <%= render "hosts/service_row", service: service %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
