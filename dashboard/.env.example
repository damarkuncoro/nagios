# Rails Environment Config
RAILS_ENV=development
PORT=3000
SECRET_KEY_BASE=change_me_to_a_secure_random_string_in_production

# Nagios Core Integration Config
NAGIOS_URL=http://nagios/nagios/cgi-bin/statusjson.cgi
NAGIOS_CMD_PIPE=/nagios_var/rw/nagios.cmd
NAGIOS_AUTH_USER=nagiosadmin
NAGIOS_AUTH_PASS=nagiosadmin

# Webhook Alert Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
