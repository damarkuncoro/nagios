#!/usr/bin/env ruby
# frozen_string_literal: true

# ==============================================================================
# Standalone Pure-Ruby Nagios Monitoring Engine (nagios_engine)
# ==============================================================================
# 100% Pure-Ruby daemon that orchestrates:
# - Configuration Loading & Template Inheritance (ObjectConfigParser)
# - Interleaved Check Priority Scheduling (TimedEventQueue)
# - Non-blocking Asynchronous Worker Process Pool (WorkerProcessPool)
# - SOFT vs HARD State Transitions & Max Attempt Tracking
# - Flapping Detection & Hysteresis Calculation (FlapDetector)
# - Host Topology Reachability (DOWN vs UNREACHABLE) (HostReachabilityDetector)
# - Performance Data & Telemetry Parsing (PerfdataParser)
# - Multi-Channel Alert Viability & Webhook Dispatching (NotificationViability)
# - Runtime State Persistence & Serialization (StatusDataParser / status.dat)
# - Non-blocking FIFO Named Pipe Command Processing (ExternalCommandHandler)
# ==============================================================================

require 'optparse'
require 'fileutils'

# Load Rails environment & domain modules
require_relative '../config/environment'

module NagiosRubyEngine
  class StandaloneDaemon
    attr_reader :options, :config_catalog, :event_queue, :worker_pool, :coordinator, :running

    def initialize(options = {})
      @options = options
      @running = false
      @event_queue = Statuses::Services::TimedEventQueue.new
      @worker_pool = Statuses::Services::WorkerProcessPool.new(max_workers: options[:workers] || 8)
      @coordinator = Statuses::Services::DaemonLifecycleCoordinator.new(
        event_queue: @event_queue,
        worker_pool: @worker_pool
      )
      @host_states = {}
      @service_states = {}
      @host_histories = {}
      @service_histories = {}
      @mutex = Mutex.new
    end

    def run!
      puts "\n" + ('=' * 72)
      puts "  🚀 NAGIOS CORE - PURE-RUBY STANDALONE MONITORING ENGINE"
      puts "  Ruby Version   : #{RUBY_VERSION} (Engine: #{RUBY_ENGINE})"
      puts "  PID            : #{Process.pid}"
      puts "  Config File    : #{@options[:config_file] || 'Built-in Demo Configuration'}"
      puts "  Status File    : #{status_file_path}"
      puts "  Command Pipe   : #{command_pipe_path}"
      puts ('=' * 72) + "\n"

      load_configuration!
      return if @options[:verify_only]

      setup_signal_traps!
      setup_command_pipe!
      schedule_initial_checks!

      @running = true
      @coordinator.start!
      puts "✅ [Daemon] Engine initialized and running. Listening for events...\n\n"

      main_monitoring_loop
    end

    private

    def status_file_path
      @options[:status_file] || File.expand_path('../../tmp/status.dat', __FILE__)
    end

    def command_pipe_path
      @options[:command_pipe] || File.expand_path('../../tmp/nagios.cmd', __FILE__)
    end

    def setup_command_pipe!
      fifo_path = command_pipe_path
      FileUtils.mkdir_p(File.dirname(fifo_path))
      unless File.exist?(fifo_path)
        File.mkfifo(fifo_path) rescue nil
      end
    end

    def load_configuration!
      puts "📦 [Config] Parsing object configurations..."
      cfg_file = @options[:config_file]

      if cfg_file && File.exist?(cfg_file)
        content = File.read(cfg_file)
        @config_catalog = Statuses::Services::ObjectConfigParser.parse(content)
      else
        # Built-in comprehensive demonstration catalog
        sample_config = <<~CFG
          define host {
            host_name               localhost
            alias                   Local Monitoring Gateway
            address                 127.0.0.1
            max_check_attempts      3
            check_interval          10
            check_command           check_ping
          }

          define host {
            host_name               edge_router
            alias                   Edge Gateway Router
            address                 192.168.1.1
            parents                 localhost
            max_check_attempts      2
            check_interval          15
            check_command           check_ping
          }

          define service {
            host_name               localhost
            service_description     Ping Latency
            check_command           ping -c 1 127.0.0.1
            check_interval          10
            max_check_attempts      3
          }

          define service {
            host_name               localhost
            service_description     Disk Usage
            check_command           df -k / | awk 'NR==2 {print "DISK OK - free space: "$4"KB | used="$3"KB;free="$4"KB"}'
            check_interval          15
            max_check_attempts      3
          }

          define service {
            host_name               localhost
            service_description     HTTP API Endpoint
            check_command           curl -s -o /dev/null -w "HTTP OK - Response %{http_code} in %{time_total}s | time=%{time_total}s;1.0;2.0" http://127.0.0.1:3000/healthz || echo "HTTP OK - Simulation | time=0.012s;1.0;2.0"
            check_interval          12
            max_check_attempts      3
          }
        CFG
        @config_catalog = Statuses::Services::ObjectConfigParser.parse(sample_config)
      end

      puts "    ✓ Registered Hosts    : #{@config_catalog.hosts.size}"
      puts "    ✓ Registered Services : #{@config_catalog.services.size}"
      puts "    ✓ Registered Commands : #{@config_catalog.commands.size}"

      if @options[:verify_only]
        puts "\n✅ [Verification] Configuration syntax OK! No errors detected.\n"
      end
    end

    def schedule_initial_checks!
      now = Time.now.to_i

      # Schedule Host Checks
      @config_catalog.hosts.each do |host_name, host_data|
        interval = (host_data['check_interval'] || 30).to_i
        cmd = host_data['check_command'] || "ping -c 1 #{host_data['address'] || '127.0.0.1'}"
        @event_queue.schedule(
          type: :host_check,
          run_time: now,
          interval: interval,
          target: host_name,
          payload: { command: cmd, host_data: host_data }
        )
      end

      # Schedule Service Checks with interleaved start times
      items = @config_catalog.services
      @event_queue.schedule_interleaved(items, type: :service_check, interval_seconds: 15, start_time: now) do |event|
        svc_data = event.target
        host_name = svc_data['host_name']
        svc_desc = svc_data['service_description']
        cmd = svc_data['check_command'] || 'true'

        event.payload = {
          host_name: host_name,
          service_description: svc_desc,
          command: cmd,
          svc_data: svc_data
        }
      end

      puts "📅 [Scheduler] Queued #{@event_queue.size} checks into Priority Queue."
    end

    def main_monitoring_loop
      last_flush = Time.now.to_i

      while @running
        now = Time.now.to_i

        # 1. Process due events
        due_events = @event_queue.process_due(now)
        due_events.each do |event|
          execute_event(event)
        end

        # 2. Check and process external command FIFO pipe
        process_external_commands!

        # 3. Periodically dump runtime status.dat (every 10s)
        if now - last_flush >= 10
          dump_runtime_status!
          last_flush = now
        end

        sleep 0.5
      end

      shutdown!
    end

    def execute_event(event)
      case event.type
      when :host_check
        execute_host_check(event)
      when :service_check
        execute_service_check(event)
      end
    end

    def execute_host_check(event)
      host_name = event.target
      cmd = event.payload[:command]
      host_data = event.payload[:host_data] || {}
      max_attempts = (host_data['max_check_attempts'] || 3).to_i

      Thread.new do
        result = @worker_pool.run_job(cmd, timeout: 10.0)
        parsed = Statuses::Services::PerfdataParser.parse(result.output)

        @mutex.synchronize do
          prev = @host_states[host_name] || {}
          prev_state = prev['current_state'].to_i
          raw_exit = result.exit_code

          # Host State: 0=UP, 1=DOWN, 2=UNREACHABLE
          calculated_state = raw_exit == 0 ? 0 : 1

          # Host Reachability Evaluation (Parent Hierarchy)
          parents = host_data['parents'].to_s.split(',').map(&:strip)
          if calculated_state > 0 && parents.any?
            parent_states = parents.map { |p| @host_states.dig(p, 'current_state').to_i }
            if parent_states.any? { |st| st > 0 }
              calculated_state = 2 # UNREACHABLE
            end
          end

          # SOFT vs HARD state transition
          attempts = prev['current_attempt'].to_i
          state_type = prev['state_type'].to_i # 0=SOFT, 1=HARD

          if calculated_state == 0
            attempts = 1
            state_type = 1 # HARD OK
          else
            attempts += 1
            state_type = attempts >= max_attempts ? 1 : 0
          end

          # Flap Detection History
          @host_histories[host_name] ||= []
          @host_histories[host_name] << calculated_state
          @host_histories[host_name].shift if @host_histories[host_name].size > 21

          flap_eval = Statuses::Services::FlapDetector.evaluate(
            @host_histories[host_name],
            current_flapping: prev['is_flapping'].to_i == 1
          )

          state_name = case calculated_state
                       when 0 then 'UP'
                       when 1 then 'DOWN'
                       else 'UNREACHABLE'
                       end

          color = case calculated_state
                  when 0 then "\e[32m"
                  when 1 then "\e[31m"
                  else "\e[33m"
                  end

          type_str = state_type == 1 ? 'HARD' : 'SOFT'
          flap_str = flap_eval.flapping? ? ' \e[35m[FLAPPING]\e[0m' : ''

          puts "#{color}[HOST CHECK]\e[0m #{Time.now.strftime('%H:%M:%S')} #{host_name.ljust(14)} => #{state_name} (#{type_str} #{attempts}/#{max_attempts})#{flap_str} | #{parsed.short_output}"

          # Notification Evaluation
          if state_type == 1 && prev_state != calculated_state && calculated_state > 0
            dispatch_alert(
              host_name: host_name,
              service_desc: nil,
              status: state_name,
              output: parsed.short_output
            )
          elsif state_type == 1 && prev_state > 0 && calculated_state == 0
            dispatch_alert(
              host_name: host_name,
              service_desc: nil,
              status: 'RECOVERY',
              output: "Host recovered: #{parsed.short_output}"
            )
          end

          @host_states[host_name] = {
            'host_name' => host_name,
            'current_state' => calculated_state,
            'last_state' => prev_state,
            'state_type' => state_type,
            'current_attempt' => attempts,
            'max_attempts' => max_attempts,
            'plugin_output' => parsed.short_output,
            'perf_data' => parsed.perf_data_string,
            'last_check' => Time.now.to_i,
            'execution_time' => result.execution_time,
            'is_flapping' => flap_eval.flapping? ? 1 : 0,
            'percent_state_change' => flap_eval.percent_state_change,
            'notifications_enabled' => 1
          }
        end
      end
    end

    def execute_service_check(event)
      payload = event.payload || {}
      host_name = payload[:host_name]
      svc_desc = payload[:service_description]
      cmd = payload[:command]
      svc_data = payload[:svc_data] || {}
      max_attempts = (svc_data['max_check_attempts'] || 3).to_i

      Thread.new do
        result = @worker_pool.run_job(cmd, timeout: 10.0)
        parsed = Statuses::Services::PerfdataParser.parse(result.output)

        @mutex.synchronize do
          @service_states[host_name] ||= {}
          prev = @service_states[host_name][svc_desc] || {}
          prev_state = prev['current_state'].to_i
          new_state = result.exit_code

          # SOFT vs HARD state transition
          attempts = prev['current_attempt'].to_i
          state_type = prev['state_type'].to_i

          if new_state == 0
            attempts = 1
            state_type = 1 # HARD OK
          else
            attempts += 1
            state_type = attempts >= max_attempts ? 1 : 0
          end

          # Flap Detection History
          key = "#{host_name}/#{svc_desc}"
          @service_histories[key] ||= []
          @service_histories[key] << new_state
          @service_histories[key].shift if @service_histories[key].size > 21

          flap_eval = Statuses::Services::FlapDetector.evaluate(
            @service_histories[key],
            current_flapping: prev['is_flapping'].to_i == 1
          )

          color = case new_state
                  when 0 then "\e[32m"
                  when 1 then "\e[33m"
                  when 2 then "\e[31m"
                  else "\e[35m"
                  end

          type_str = state_type == 1 ? 'HARD' : 'SOFT'
          flap_str = flap_eval.flapping? ? ' \e[35m[FLAPPING]\e[0m' : ''

          puts "#{color}[SVC CHECK]\e[0m  #{Time.now.strftime('%H:%M:%S')} #{host_name}/#{svc_desc.ljust(18)} => #{result.status_name} (#{type_str} #{attempts}/#{max_attempts})#{flap_str} | #{parsed.short_output}"

          # Notification Evaluation
          if state_type == 1 && prev_state != new_state && new_state > 0
            dispatch_alert(
              host_name: host_name,
              service_desc: svc_desc,
              status: result.status_name,
              output: parsed.short_output
            )
          elsif state_type == 1 && prev_state > 0 && new_state == 0
            dispatch_alert(
              host_name: host_name,
              service_desc: svc_desc,
              status: 'RECOVERY',
              output: "Service recovered: #{parsed.short_output}"
            )
          end

          @service_states[host_name][svc_desc] = {
            'host_name' => host_name,
            'service_description' => svc_desc,
            'current_state' => new_state,
            'last_state' => prev_state,
            'state_type' => state_type,
            'current_attempt' => attempts,
            'max_attempts' => max_attempts,
            'plugin_output' => parsed.short_output,
            'perf_data' => parsed.perf_data_string,
            'last_check' => Time.now.to_i,
            'execution_time' => result.execution_time,
            'is_flapping' => flap_eval.flapping? ? 1 : 0,
            'percent_state_change' => flap_eval.percent_state_change,
            'notifications_enabled' => 1
          }
        end
      end
    end

    def dispatch_alert(host_name:, service_desc:, status:, output:)
      Thread.new do
        target_obj = { notifications_enabled: 1 }
        viability = Statuses::Services::NotificationViability.check(target_obj)
        if viability.viable?
          puts "🔔 [ALERT DISPATCH] #{status}: #{host_name} #{service_desc} => #{output}"
          Statuses::Services::NotificationService.deliver_alert(
            host_name: host_name,
            service_desc: service_desc,
            status: status,
            plugin_output: output
          )
        end
      end
    end

    def dump_runtime_status!
      target_file = status_file_path
      FileUtils.mkdir_p(File.dirname(target_file))

      @mutex.synchronize do
        snapshot = Statuses::Services::StatusDataParser::StatusSnapshot.new(
          info: {
            'created' => Time.now.to_i,
            'version' => '4.5.14-PureRuby'
          },
          programstatus: {
            'program_start' => @coordinator.status.start_time.to_i,
            'nagios_pid' => Process.pid,
            'is_currently_running' => 1,
            'total_services' => @service_states.values.sum(&:size),
            'total_hosts' => @host_states.size,
            'active_workers' => @worker_pool.stats[:active_workers]
          },
          hosts: @host_states,
          services: @service_states,
          contacts: {},
          comments: [],
          downtimes: []
        )

        content = Statuses::Services::StatusDataParser.serialize(snapshot)
        File.write(target_file, content)
      end
    end

    def process_external_commands!
      fifo_path = command_pipe_path
      return unless File.exist?(fifo_path) && File.pipe?(fifo_path)

      begin
        fifo = File.open(fifo_path, File::RDONLY | File::NONBLOCK)
        lines = fifo.read_nonblock(8192) rescue nil
        fifo.close
        if lines
          lines.each_line do |cmd|
            clean_cmd = cmd.strip
            next if clean_cmd.empty?

            puts "📥 [External Command] Processing: #{clean_cmd}"
            Statuses::Services::ExternalCommandHandler.process(clean_cmd)
          end
        end
      rescue => _e
        # Ignore non-blocking read transients
      end
    end

    def setup_signal_traps!
      %w[INT TERM].each do |signal|
        trap(signal) do
          puts "\n\n⚠️  Received SIG#{signal}. Gracefully stopping Ruby Engine..."
          @running = false
        end
      end
    end

    def shutdown!
      @coordinator.stop!
      dump_runtime_status!
      puts "🛑 [Daemon] Engine stopped. Runtime status successfully saved to #{status_file_path}."
      puts "Done. 👋\n\n"
    end
  end
end

# CLI Argument Parsing
options = {}
OptionParser.new do |opts|
  opts.banner = "Usage: nagios_engine [options]"

  opts.on("-c", "--config FILE", "Path to Nagios object configuration (.cfg) file") do |f|
    options[:config_file] = f
  end

  opts.on("-v", "--verify", "Verify configuration syntax and exit") do
    options[:verify_only] = true
  end

  opts.on("-w", "--workers COUNT", Integer, "Max worker threads in process pool (default: 8)") do |w|
    options[:workers] = w
  end

  opts.on("-s", "--status-file FILE", "Path to write runtime status.dat (default: tmp/status.dat)") do |sf|
    options[:status_file] = sf
  end

  opts.on("-p", "--pipe FILE", "Path to external command FIFO pipe (default: tmp/nagios.cmd)") do |p|
    options[:command_pipe] = p
  end

  opts.on("-h", "--help", "Prints this help message") do
    puts opts
    exit
  end
end.parse!

NagiosRubyEngine::StandaloneDaemon.new(options).run!
