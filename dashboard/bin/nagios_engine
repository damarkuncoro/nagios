#!/usr/bin/env ruby
# frozen_string_literal: true

# ==============================================================================
# Standalone Pure-Ruby Nagios Monitoring Engine (nagios_engine)
# ==============================================================================
# 100% Pure-Ruby daemon runner coordinating:
# - ObjectConfigParser: Configuration Loading & Template Inheritance
# - TimedEventQueue: Check Priority Scheduling & Interleaved Execution
# - WorkerProcessPool: Non-blocking Multi-thread Process Pool
# - CheckExecutor: SOFT/HARD Transitions, Flapping Hysteresis, Reachability & Alerts
# - ExternalCommandApplier: Real-time FIFO Named Pipe Command Processing
# - StatusDumper: Atomic Runtime State Persistence to status.dat
# ==============================================================================

require 'optparse'

# Boot Rails environment & domain autoloading
require_relative '../config/environment'

options = {}
OptionParser.new do |opts|
  opts.banner = "Usage: nagios_engine [options]"

  opts.on("-c", "--config FILE", "Path to Nagios object configuration (.cfg) file") do |f|
    options[:config_file] = f
  end

  opts.on("-v", "--verify", "Verify configuration syntax and exit") do
    options[:verify_only] = true
  end

  opts.on("-w", "--workers COUNT", Integer, "Max worker threads in process pool (default: 8)") do |w|
    options[:workers] = w
  end

  opts.on("-s", "--status-file FILE", "Path to write runtime status.dat (default: tmp/status.dat)") do |sf|
    options[:status_file] = sf
  end

  opts.on("-p", "--pipe FILE", "Path to external command FIFO pipe (default: tmp/nagios.cmd)") do |p|
    options[:command_pipe] = p
  end

  opts.on("-l", "--log-file FILE", "Path to append Nagios event log (default: tmp/nagios.log)") do |l|
    options[:log_file] = l
  end

  opts.on("--pid-file FILE", "Path to daemon PID file (default: tmp/nagios.pid)") do |pf|
    options[:pid_file] = pf
  end

  opts.on("-h", "--help", "Prints this help message") do
    puts opts
    exit
  end
end.parse!

Engines::StandaloneDaemon.new(options).run!
